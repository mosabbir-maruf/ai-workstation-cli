#!/usr/bin/env python3

import os
import socket
import subprocess
import sys
from pathlib import Path


def get_root():
    root = os.environ.get("AI_WORKSTATION_ROOT")
    if root:
        p = Path(root).resolve()
        if p.is_dir() and (p / "broker/github_broker.py").is_file():
            return p

    default_root = Path(__file__).resolve().parent.parent
    if default_root.is_dir() and (default_root / "broker/github_broker.py").is_file():
        return default_root

    try:
        result = subprocess.run(
            ["git", "config", "--global", "--get", "ai.workstation.root"],
            check=False,
            capture_output=True,
            text=True,
        )
        value = result.stdout.strip()
        if value:
            p = Path(value).resolve()
            if p.is_dir() and (p / "broker/github_broker.py").is_file():
                return p
    except Exception:
        pass

    return default_root


def main():
    action = sys.argv[1] if len(sys.argv) > 1 else "get"

    # Git may call these when storing/erasing credentials.
    # We intentionally never persist GitHub tokens.
    if action in ("store", "erase"):
        return 0

    if action != "get":
        return 0

    root = get_root()
    socket_path = root / "runtime/github-broker/github.sock"

    request = sys.stdin.read()

    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
        sock.connect(str(socket_path))
        sock.sendall(request.encode())
        sock.shutdown(socket.SHUT_WR)

        chunks = []
        while True:
            data = sock.recv(4096)
            if not data:
                break
            chunks.append(data)

    sys.stdout.write(b"".join(chunks).decode())


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        print(f"credential helper error: {exc}", file=sys.stderr)
        raise SystemExit(1)
