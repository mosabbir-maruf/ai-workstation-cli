# --------------------------------------------------
# Interactive TUI Menu System
# --------------------------------------------------
render_menu() {
    local prompt="$1"
    shift
    local options=("$@")
    local selected=0
    local key

    tput civis
    tput sc

    trap 'tput cnorm; echo; exit 1' INT

    while true; do
        tput rc
        echo -e "\n\033[1m$prompt\033[0m\n"
        for i in "${!options[@]}"; do
            if [[ "$i" -eq "$selected" ]]; then
                echo -e "  \033[36m\033[1m❯ ${options[$i]}\033[0m\033[K"
            else
                echo -e "    ${options[$i]}\033[K"
            fi
        done

        echo -e "\n\033[90m[\033[36m ↑/↓ or j/k \033[90m] Navigate    [\033[36m Enter \033[90m] Select    [\033[36m h \033[90m] Help    [\033[36m q \033[90m] Quit\033[0m\033[K"

        read -rsn1 key || true
        if [[ "$key" == $'\x1b' ]]; then
            read -rsn2 -t 0.1 key || true
            if [[ "$key" == "[A" || "$key" == "A" || "$key" == "OA" ]]; then
                selected=$((selected - 1))
                [[ "$selected" -lt 0 ]] && selected=$((${#options[@]} - 1)) || true
            elif [[ "$key" == "[B" || "$key" == "B" || "$key" == "OB" ]]; then
                selected=$((selected + 1))
                [[ "$selected" -ge ${#options[@]} ]] && selected=0 || true
            fi
        elif [[ "$key" == "k" || "$key" == "w" || "$key" == "W" || "$key" == "K" ]]; then
            selected=$((selected - 1))
            [[ "$selected" -lt 0 ]] && selected=$((${#options[@]} - 1)) || true
        elif [[ "$key" == "j" || "$key" == "s" || "$key" == "S" || "$key" == "J" ]]; then
            selected=$((selected + 1))
            [[ "$selected" -ge ${#options[@]} ]] && selected=0 || true
        elif [[ "$key" == "h" || "$key" == "H" ]]; then
            tput cnorm
            tput rc
            tput ed
            clear
            print_header "HELP & CLI USAGE"
            print_usage_text
            echo -e -n "\n\033[90m[\033[36m Enter \033[90m] Return to menu...\033[0m"
            read -r || true
            clear
            print_aiws_banner
            tput civis
            tput sc
        elif [[ "$key" == "q" || "$key" == "Q" ]]; then
            tput cnorm
            tput rc
            tput ed
            exit 0
        elif [[ "$key" == "" ]]; then
            break
        fi
    done

    tput cnorm
    tput rc
    tput ed
    return "$selected"
}

cmd_tui() {
    load_env 2>/dev/null || true
    local is_setup_mode=0
    if [[ "${1:-}" == "--setup" ]]; then
        is_setup_mode=1
    elif [[ ! -f "$RUNTIME_DIR/.setup_done" && -z "${ACTIVE_PROJECT:-}" ]]; then
        is_setup_mode=1
    fi

    while true; do
        if [[ "$is_setup_mode" -eq 1 ]]; then
            local setup_opts=("Yes, start Setup Wizard" "Skip for now")
            clear
            print_aiws_banner
            echo
            local choice=0
            render_menu "First-time installation detected. Start guided setup?" "${setup_opts[@]}" || choice=$?
            if [[ "$choice" -eq 0 ]]; then
                cmd_setup
            fi
            is_setup_mode=0
            touch "$RUNTIME_DIR/.setup_done"
            continue
        fi

        local main_opts=(
            "Start / Restart AIWS"
            "Stop AIWS"
            "Check Status"
            "View Logs"
            "Open Shell"
            "Setup & Configuration"
            "Cloud & Git Integrations"
            "Update AIWS CLI"
            "Uninstall AIWS"
            "Help / CLI Commands"
            "Exit"
        )
        
        clear
        print_aiws_banner
        echo
        
        local choice=0
        render_menu "Interactive AIWS Dashboard (Use Arrow Keys)" "${main_opts[@]}" || choice=$?
        
        clear
        print_aiws_banner
        echo

        case "$choice" in
            0) cmd_start ;;
            1) cmd_stop ;;
            2) cmd_status ;;
            3) cmd_logs ;;
            4) cmd_shell ;;
            5) cmd_setup ;;
            6) 
               local tunnel_opts=("GitHub App Setup" "Cloudflare Tunnel Setup" "Back to Main Menu")
               local tun_choice=0
               render_menu "Cloud & Git Integrations" "${tunnel_opts[@]}" || tun_choice=$?
               if [[ "$tun_choice" -eq 0 ]]; then
                   cmd_github setup
               elif [[ "$tun_choice" -eq 1 ]]; then
                   [[ -f "$TUNNEL_LIB" ]] && bash "$TUNNEL_LIB" setup || echo "Tunnel module missing."
               fi
               ;;
            7) cmd_update ;;
            8) cmd_uninstall ;;
            9) 
               print_header "HELP & CLI USAGE"
               print_usage_text 
               ;;
            10) 
               local goodbyes=(
                   "Catch you on the flip side! (⌐■_■)"
                   "Disconnecting from the matrix... [>_ ]"
                   "See you space cowboy... *~"
                   "Shutting down the mainframe... [OK]"
                   "AIWS out. Have a great day! \o/"
                   "Don't forget to push your code! git push -f"
                   "Time for a coffee break? c[_]"
                   "Terminating session. Hasta la vista! [TERMINATED]"
                   "My battery is low and it's getting dark... just kidding!"
                   "Going to sleep. Dream of electric sheep! zZz"
               )
               local rand_idx=$((RANDOM % ${#goodbyes[@]}))
               echo -e "\n  \033[36m${goodbyes[$rand_idx]}\033[0m\n"
               exit 0 
               ;;
        esac
        
        if [[ "$choice" -ne 10 ]]; then
            echo
            echo -e "\033[90m[\033[36m Enter \033[90m] Return to menu\033[0m\033[K"
            read -r -s
        fi
    done
}

case "${1:-}" in
    tui) shift; cmd_tui "$@" ;;
    banner) shift; print_aiws_banner "$@" ;;
    setup|init|onboard) shift; cmd_setup "$@" ;;
    add) shift; cmd_add "$@" ;;
    remove) shift; cmd_remove "$@" ;;
    list) cmd_list ;;
    use) shift; cmd_use "$@" ;;
    diff) cmd_diff ;;
    pull) cmd_pull ;;
    push) shift; cmd_push "$@" ;;
    git) shift; cmd_git "$@" ;;
    start) cmd_start ;;
    stop) cmd_stop ;;
    restart) cmd_restart ;;
    harness)
        shift
        case "${1:-}" in
            start)
                cmd_harness_start
                ;;
            stop)
                cmd_harness_stop
                ;;
            restart)
                cmd_harness_restart
                ;;
            status)
                cmd_harness_status
                ;;
            sync)
                cmd_harness_sync
                ;;
            *)
                die "Usage: aiws harness {start|stop|restart|status|sync}"
                ;;
        esac
        ;;
    status) cmd_status ;;
    logs) cmd_logs ;;
    shell) cmd_shell ;;
    run) cmd_run ;;
    app)
        shift
        case "${1:-}" in
            stop)
                cmd_app_stop
                ;;
            restart)
                cmd_app_restart
                ;;
            status)
                cmd_app_status
                ;;
            logs)
                cmd_app_logs
                ;;
            *)
                die "Usage: aiws app {stop|restart|status|logs}"
                ;;
        esac
        ;;
    preview) cmd_preview ;;
    dsh)
        shift
        case "${1:-}" in
            update)
                shift
                cmd_dsh_update "$@"
                ;;
            version)
                cmd_dsh_version
                ;;
            *)
                die "Usage: aiws dsh {update|version}"
                ;;
        esac
        ;;
    cache)
        shift

        case "${1:-}" in
            clear)
                shift
                cmd_cache_clear "$@"
                ;;
            --help|-h|"")
                cmd_cache
                ;;
            *)
                die "Usage: aiws cache [clear [--deps] [--yes]]"
                ;;
        esac
        ;;
    update) cmd_update ;;
    upgrade) cmd_upgrade ;;
    uninstall) shift; cmd_uninstall "$@" ;;
    doctor) cmd_doctor ;;
    github)
        shift
        cmd_github "$@"
        ;;
    tunnel)
        shift
        [[ -f "$TUNNEL_LIB" ]] ||
            die "Tunnel module not found: $TUNNEL_LIB"
        case "${1:-}" in
            setup|sync|status|start|stop|logs)
                bash "$TUNNEL_LIB" "$@"
                ;;
            *)
                die "Usage: aiws tunnel {setup|sync [port]|status|start|stop|logs}"
                ;;
        esac
        ;;
    state)
        shift
        case "${1:-}" in
            export) cmd_state_export ;;
            import)
                shift
                cmd_state_import "$@"
                ;;
            *)
                die "Usage: aiws state {export|import}"
                ;;
        esac
        ;;
    daemon)
        shift
        cmd_daemon "${1:-status}"
        ;;
    "")
        if [[ -t 0 && -t 1 ]]; then
            cmd_tui
        else
            usage
        fi
        ;;
    help|--help|-h) usage ;;
    *) die "Unknown command: $1" ;;
esac
