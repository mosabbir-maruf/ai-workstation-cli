#!/usr/bin/env bash
set -euo pipefail

RESOLVED_SOURCE="${BASH_SOURCE[0]}"
while [ -L "$RESOLVED_SOURCE" ]; do
    TARGET="$(readlink "$RESOLVED_SOURCE")"
    if [[ "$TARGET" == /* ]]; then
        RESOLVED_SOURCE="$TARGET"
    else
        RESOLVED_SOURCE="$(dirname "$RESOLVED_SOURCE")/$TARGET"
    fi
done
SCRIPT_ROOT="$(cd "$(dirname "$RESOLVED_SOURCE")/.." && pwd)"
ROOT="${AIWS_ROOT:-$SCRIPT_ROOT}"
if [[ ! -d "$ROOT" || ! -f "$ROOT/broker/github_broker.py" ]]; then
    ROOT="$SCRIPT_ROOT"
fi
ENV_FILE="$ROOT/.env"
COMPOSE_FILE="$ROOT/docker/compose.yml"
PROJECTS_DIR="$HOME/projects"
RUNTIME_DIR="$ROOT/runtime"
HARNESS_RUNTIME_DIR="$RUNTIME_DIR/harness"
APP_RUNTIME_DIR="$RUNTIME_DIR/app"
APP_PID_FILE="$APP_RUNTIME_DIR/pid"
APP_BRIDGE_PID_FILE="$APP_RUNTIME_DIR/bridge.pid"
GITHUB_LIB="$ROOT/scripts/lib/github.sh"
TUNNEL_LIB="$ROOT/scripts/lib/tunnel.sh"
PORTS_LIB="$ROOT/scripts/lib/ports.sh"

mkdir -p "$PROJECTS_DIR" "$RUNTIME_DIR" "$HARNESS_RUNTIME_DIR" "$APP_RUNTIME_DIR"

print_header() {
    local text="$1"
    local text_len=${#text}
    local border=""
    for (( i=0; i<text_len+2; i++ )); do border+="─"; done
    echo -e "\033[36m╭${border}╮\033[0m"
    echo -e "\033[36m│\033[0m \033[1m${text}\033[0m \033[36m│\033[0m"
    echo -e "\033[36m╰${border}╯\033[0m"
}
export -f print_header

log_info() {
    echo -e "\033[90m[\033[36mi\033[90m]\033[0m $1"
}

log_success() {
    echo -e "\033[90m[\033[32m✓\033[90m]\033[0m $1"
}

log_error() {
    echo -e "\033[90m[\033[31m✗\033[90m]\033[0m $1" >&2
}

die() {
    log_error "$*"
    exit 1
}

_sed_i() {
    if sed --version 2>&1 | grep -q "GNU"; then
        sed -i "$@"
    else
        sed -i '' "$@"
    fi
}

load_env() {
    [[ -f "$ENV_FILE" ]] || cp "$ROOT/.env.example" "$ENV_FILE"

    local env_image="${IMAGE:-}"
    local env_dsh_version="${DSH_VERSION:-}"
    local env_root="${AIWS_ROOT:-}"

    set -a
    source "$ENV_FILE"
    set +a

    [[ -n "$env_image" ]] && IMAGE="$env_image"
    [[ -n "$env_dsh_version" ]] && DSH_VERSION="$env_dsh_version"
    [[ -n "$env_root" ]] && AIWS_ROOT="$env_root"

    if [[ ! -d "${AIWS_ROOT:-}" || ! -f "${AIWS_ROOT:-}/broker/github_broker.py" ]]; then
        AIWS_ROOT="$ROOT"
        if grep -q '^AIWS_ROOT=' "$ENV_FILE" 2>/dev/null; then
            _sed_i "s|^AIWS_ROOT=.*|AIWS_ROOT=${ROOT}|" "$ENV_FILE"
        fi
    fi

    # Dev-server hostname allowlist: explicit value wins, otherwise fall
    # back to the tunnel app hostname so `aiws tunnel setup` wires it up
    # with no extra step. Empty = local-only.
    ALLOWED_HOSTS="${ALLOWED_HOSTS:-${CLOUDFLARED_APP_HOSTNAME:-}}"

    export IMAGE DSH_VERSION AIWS_ROOT ALLOWED_HOSTS
}

set_env_var() {
    local key="$1"
    local value="$2"
    [[ -f "$ENV_FILE" ]] || cp "$ROOT/.env.example" "$ENV_FILE"
    if grep -q "^${key}=" "$ENV_FILE" 2>/dev/null; then
        _sed_i "s|^${key}=.*|${key}=${value}|" "$ENV_FILE"
    else
        printf '%s=%s\n' "$key" "$value" >> "$ENV_FILE"
    fi
    printf -v "$key" '%s' "$value"
    export "${key?}"
}

save_env() {
    local cur_active="${ACTIVE_PROJECT-__UNSET__}"
    local cur_active_path="${ACTIVE_PROJECT_PATH-__UNSET__}"
    local cur_dsh_ver="${DSH_VERSION-__UNSET__}"
    local cur_api_key="${WORKSTATION_API_KEY-__UNSET__}"

    [[ -f "$ENV_FILE" ]] && source "$ENV_FILE"

    [[ "$cur_active" != "__UNSET__" ]] && ACTIVE_PROJECT="$cur_active"
    [[ "$cur_active_path" != "__UNSET__" ]] && ACTIVE_PROJECT_PATH="$cur_active_path"
    [[ "$cur_dsh_ver" != "__UNSET__" && -n "$cur_dsh_ver" ]] && DSH_VERSION="$cur_dsh_ver"
    [[ "$cur_api_key" != "__UNSET__" && -n "$cur_api_key" ]] && WORKSTATION_API_KEY="$cur_api_key"

    local workstation_root="${AIWS_ROOT:-$ROOT}"
    if [[ ! -d "$workstation_root" || ! -f "$workstation_root/broker/github_broker.py" ]]; then
        workstation_root="$ROOT"
    fi

    cat > "$ENV_FILE" <<EOF2
IMAGE=${IMAGE:-ghcr.io/mosabbir-maruf/aiws-cli:latest}
DSH_VERSION=${DSH_VERSION:-0.1.2-rc.1}
DSH_TRUSTED_HOSTS=${DSH_TRUSTED_HOSTS:-}
ALLOWED_HOSTS=${ALLOWED_HOSTS:-}
ACTIVE_PROJECT=${ACTIVE_PROJECT:-}
ACTIVE_PROJECT_PATH=${ACTIVE_PROJECT_PATH:-}
AIWS_ROOT=$workstation_root
WORKSTATION_API_KEY=${WORKSTATION_API_KEY:-}
GITHUB_APP_ID=${GITHUB_APP_ID:-}
GITHUB_INSTALLATION_ID=${GITHUB_INSTALLATION_ID:-}
GITHUB_BROKER_SOCKET=${GITHUB_BROKER_SOCKET:-}
GITHUB_BROKER_GID=${GITHUB_BROKER_GID:-}
CLOUDFLARED_TOKEN_SET=${CLOUDFLARED_TOKEN_SET:-}
CLOUDFLARED_APP_HOSTNAME=${CLOUDFLARED_APP_HOSTNAME:-}
CLOUDFLARED_DSH_HOSTNAME=${CLOUDFLARED_DSH_HOSTNAME:-}
CLOUDFLARED_APP_PORT=${CLOUDFLARED_APP_PORT:-}
EOF2
}
compose() {
    load_env
    docker compose \
        --project-directory "$ROOT" \
        -f "$COMPOSE_FILE" \
        "$@"
}

require_active() {
    load_env
    [[ -n "${ACTIVE_PROJECT:-}" ]] ||
        die "No active project. Use: aiws use <project>"

    [[ -d "${ACTIVE_PROJECT_PATH:-}" ]] ||
        die "Active project path does not exist."
}

cmd_add() {
    local url="${1:-}"
    [[ -n "$url" ]] || die "Usage: aiws add <github-url>"

    [[ "$url" =~ ^https://github\.com/[^/]+/[^/]+/?(\.git)?$ ]] ||
        die "Only valid GitHub HTTPS repository URLs are supported."

    local name
    name="$(basename "${url%/}")"
    name="${name%.git}"

    [[ "$name" != "." && "$name" != ".." ]] ||
        die "Invalid repository name."

    [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]] ||
        die "Invalid repository name: $name"

    local destination="$PROJECTS_DIR/$name"

    [[ ! -e "$destination" ]] ||
        die "Project already exists: $name"

    if ! git clone "$url" "$destination"; then
        rm -rf -- "$destination"
        die "Failed to clone repository: $name"
    fi

    echo "Project added: $name"
    echo "Run: aiws use $name"
}

cmd_remove() {
    local name="${1:-}"
    [[ -n "$name" ]] || die "Usage: aiws remove <project>"

    [[ "$name" != "." && "$name" != ".." ]] ||
        die "Invalid project name."

    [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]] ||
        die "Invalid project name: $name"

    local destination="$PROJECTS_DIR/$name"

    [[ -d "$destination" ]] ||
        die "Project not found: $name"

    [[ -d "$destination/.git" ]] ||
        die "Not a Git project: $name"

    load_env

    if [[ "${ACTIVE_PROJECT:-}" == "$name" ]]; then
        log_info "Stopping workstation..."

        compose down >/dev/null 2>&1 || true

        ACTIVE_PROJECT=""
        ACTIVE_PROJECT_PATH=""
        save_env
    fi

    rm -rf -- "$destination"

    echo "Removed: $name"
}

cmd_list() {
    echo "Projects:"
    shopt -s nullglob
    load_env

    local found=0
    local dir_name

    for dir in "$PROJECTS_DIR"/*; do
        if [[ -d "$dir/.git" ]]; then
            found=1
            dir_name="${dir##*/}"
            if [[ "${ACTIVE_PROJECT:-}" == "$dir_name" ]]; then
                echo "  * $dir_name"
            else
                echo "    $dir_name"
            fi
        fi
    done

    [[ "$found" -eq 1 ]] || echo "  (none)"
}

cmd_use() {
    local name="${1:-}"
    [[ -n "$name" ]] || die "Usage: aiws use <project>"

    local path="$PROJECTS_DIR/$name"

    [[ -d "$path/.git" ]] ||
        die "Git project not found: $name"

    load_env

    if [[ "${ACTIVE_PROJECT:-}" == "$name" ]]; then
        echo "Already active: $name"
        return 0
    fi

    local workstation_running=0

    if docker ps --format '{{.Names}}' |
       grep -qx aiws-cli; then
        workstation_running=1
    fi

    ACTIVE_PROJECT="$name"
    ACTIVE_PROJECT_PATH="$path"

    save_env

    if [[ "$workstation_running" -eq 1 ]]; then
        echo "Switching workstation workspace..."

        compose up -d --force-recreate

        cmd_harness_start
    fi

    echo "Active project: $name"
    echo "Path: $path"
}

cmd_diff() {
    require_active
    cd "$ACTIVE_PROJECT_PATH"
    if [[ ! -d ".git" ]]; then
        die "Not a git repository: $ACTIVE_PROJECT_PATH"
    fi

    echo; print_header "WORKING TREE STATUS"
    git status --short
    echo ""
    echo; print_header "WORKING TREE DIFF"
    git diff HEAD 2>/dev/null || git diff
}

cmd_pull() {
    require_active
    cd "$ACTIVE_PROJECT_PATH"
    git pull --ff-only
}

cmd_git() {
    require_active
    cd "$ACTIVE_PROJECT_PATH"
    git "$@"
}

cmd_push() {
    local message="${1:-}"
    [[ -n "$message" ]] || die 'Usage: aiws push "commit message"'

    require_active

    cd "$ACTIVE_PROJECT_PATH"

    git add -A

    if git diff --cached --quiet; then
        echo "Nothing to commit."
        return
    fi

    local sensitive_files=""
    sensitive_files="$(
        git diff --cached --name-only --diff-filter=ACM |
        while IFS= read -r file; do
            case "$file" in
                .env|.env.*)
                    [[ "$file" == ".env.example" ]] || echo "$file"
                    ;;
                *.pem|*.key|*.p12|*.pfx)
                    echo "$file"
                    ;;
                credentials.json|service-account*.json)
                    echo "$file"
                    ;;
            esac
        done
    )"

    if [[ -n "$sensitive_files" ]]; then
        git reset >/dev/null

        echo "ERROR: Potentially sensitive files detected:" >&2
        printf '  %s\n' "$sensitive_files" >&2
        echo >&2
        echo "Nothing was committed or pushed." >&2

        return 1
    fi

    git commit -m "$message"
    git push
}

harness_exec() {
    docker exec -i aiws-cli \
        bash -s -- "$@" < "$ROOT/docker/harness.sh"
}

cmd_harness_start() {
    docker ps --format '{{.Names}}' |
        grep -qx aiws-cli ||
        die "Workstation is not running."

    harness_exec start
}

cmd_harness_stop() {
    docker ps --format '{{.Names}}' |
        grep -qx aiws-cli ||
        return 0

    harness_exec stop
}

cmd_harness_restart() {
    docker ps --format '{{.Names}}' |
        grep -qx aiws-cli ||
        die "Workstation is not running."

    harness_exec restart
}

cmd_harness_sync() {
    docker ps --format '{{.Names}}' |
        grep -qx aiws-cli ||
        die "Workstation is not running."

    harness_exec sync
}

cmd_harness_status() {
    docker ps --format '{{.Names}}' |
        grep -qx aiws-cli ||
        {
            log_info "Harness is already stopped."
            return 0
        }

    harness_exec status || true
}

cmd_start() {
    print_header "START WORKSTATION"
    echo
    require_active

    mkdir -p \
        "$RUNTIME_DIR/dsh" \
        "$RUNTIME_DIR/npm-global" \
        "$HARNESS_RUNTIME_DIR" \
        "$APP_RUNTIME_DIR"

    chmod 775 \
        "$RUNTIME_DIR/dsh" \
        "$RUNTIME_DIR/npm-global" \
        "$HARNESS_RUNTIME_DIR" \
        "$APP_RUNTIME_DIR"

    if [[ "$(stat -c '%u:%g' "$HARNESS_RUNTIME_DIR" 2>/dev/null || true)" != "1001:1001" ]]; then
        sudo chown -R 1001:1001 "$HARNESS_RUNTIME_DIR" "$APP_RUNTIME_DIR" "$RUNTIME_DIR/dsh" 2>/dev/null || true
    fi

    compose up -d

    # Wait up to 30 seconds for the container to become running
    local attempts=0
    while ! docker ps --format '{{.Names}}' | grep -qx aiws-cli; do
        sleep 1
        attempts=$((attempts + 1))
        if [[ "$attempts" -ge 30 ]]; then
            die "Container aiws-cli failed to start within 30 seconds."
        fi
    done

    cmd_harness_start

    log_success "Workstation started."
}

cmd_stop() {
    print_header "STOP WORKSTATION"
    echo
    cmd_app_stop || true
    cmd_harness_stop || true
    compose down
    rm -f "$APP_PID_FILE" "$APP_RUNTIME_DIR/pgid" "$APP_BRIDGE_PID_FILE"
    log_success "Workstation stopped."
}

cmd_restart() {
    print_header "RESTART WORKSTATION"
    echo
    compose restart
    cmd_harness_start
}

app_container_pid() {
    local pid=""
    if [[ -f "$APP_PID_FILE" ]]; then
        pid="$(<"$APP_PID_FILE")"
        pid="${pid//[[:space:]]/}"
    fi

    if [[ "$pid" =~ ^[0-9]+$ ]] && docker exec aiws-cli sh -c "kill -0 $pid 2>/dev/null"; then
        echo "$pid"
        return 0
    fi

    # Fallback: detect running dev-server process inside container (e.g. started via DSH or orphaned)
    local detected_pid
    detected_pid="$(
        docker exec aiws-cli sh -c '
            ps -eo pid=,args= 2>/dev/null | awk "
                /node_modules\/\.bin\/(vite|next|nuxt|astro|svelte-kit|webpack|react-scripts|tsx|ts-node|nodemon)|npm run dev|pnpm dev|yarn dev|bun run dev|vite --host|next dev/ && !/awk/ && !/@deepseek-ai\/dsh/ {
                    print \$1; exit
                }
            "
        ' 2>/dev/null || true
    )"
    detected_pid="${detected_pid//[[:space:]]/}"
    if [[ "$detected_pid" =~ ^[0-9]+$ ]]; then
        echo "$detected_pid" > "$APP_PID_FILE" 2>/dev/null || true
        echo "$detected_pid"
        return 0
    fi

    return 1
}

app_running() {
    local pid
    pid="$(app_container_pid || true)"
    [[ "$pid" =~ ^[0-9]+$ ]]
}

detect_package_manager() {
    require_active

    if [[ -f "$ACTIVE_PROJECT_PATH/pnpm-lock.yaml" ]]; then
        echo "pnpm"
    elif [[ -f "$ACTIVE_PROJECT_PATH/package-lock.json" ]]; then
        echo "npm"
    elif [[ -f "$ACTIVE_PROJECT_PATH/yarn.lock" ]]; then
        echo "yarn"
    elif [[ -f "$ACTIVE_PROJECT_PATH/bun.lockb" || -f "$ACTIVE_PROJECT_PATH/bun.lock" ]]; then
        echo "bun"
    elif [[ -f "$ACTIVE_PROJECT_PATH/package.json" ]]; then
        local pkg_mgr
        pkg_mgr="$(grep -o '"packageManager"[[:space:]]*:[[:space:]]*"[^"]*"' "$ACTIVE_PROJECT_PATH/package.json" 2>/dev/null || true)"
        if [[ "$pkg_mgr" == *"pnpm"* ]]; then
            echo "pnpm"
        elif [[ "$pkg_mgr" == *"yarn"* ]]; then
            echo "yarn"
        elif [[ "$pkg_mgr" == *"bun"* ]]; then
            echo "bun"
        else
            echo "npm"
        fi
    else
        die "Could not detect package manager (no package.json or lockfile found in $ACTIVE_PROJECT_PATH)."
    fi
}

container_has_command() {
    docker exec aiws-cli sh -c "export PATH=\"/home/sandbox/.npm-global/bin:\$PATH\"; command -v \"$1\" >/dev/null 2>&1"
}

ensure_container_package_manager() {
    local mgr="$1"
    [[ "$mgr" == "npm" ]] && return 0

    # Fast path 1: check persistent host mount first (0ms, avoids docker IPC overhead)
    if [[ -x "$RUNTIME_DIR/npm-global/bin/$mgr" ]]; then
        return 0
    fi

    # Fast path 2: check container PATH
    if container_has_command "$mgr"; then
        return 0
    fi

    echo "Package manager '$mgr' not found in container. Installing globally..."
    case "$mgr" in
        pnpm)
            docker exec aiws-cli npm install --prefix /home/sandbox/.npm-global -g pnpm
            ;;
        yarn)
            docker exec aiws-cli npm install --prefix /home/sandbox/.npm-global -g yarn
            ;;
        bun)
            docker exec aiws-cli npm install --prefix /home/sandbox/.npm-global -g bun 2>/dev/null || \
                docker exec aiws-cli sh -c "curl -fsSL https://bun.sh/install | bash"
            ;;
        *)
            die "Unsupported package manager: $mgr"
            ;;
    esac

    if ! container_has_command "$mgr"; then
        die "Failed to install package manager '$mgr' inside workstation container."
    fi
    echo "✓ Package manager '$mgr' installed successfully."
}

cmd_run() {
    require_active
    load_env

    docker ps --format '{{.Names}}' |
        grep -qx aiws-cli ||
        die "Workstation is not running. Run: aiws start"

    if app_running; then
        echo "Project already running."
        echo "PID: $(app_container_pid)"
        return 0
    fi

    local manager
    manager="$(detect_package_manager)"

    # Central 0.0.0.0 handling: dev servers default to localhost inside the
    # container, which is unreachable from the host/tunnel. Auto-append the
    # framework's host flag unless the project's own dev script already
    # configures a host. Backends (Express/Nest/Fastify/...) typically bind
    # all interfaces by default or respect $HOST, so no flag is needed there.
    local host_args=""
    local bind_note="project config"
    local dev_script=""
    dev_script="$(grep -o '"dev"[[:space:]]*:[[:space:]]*"[^"]*"' "$ACTIVE_PROJECT_PATH/package.json" 2>/dev/null || true)"

    if [[ "$dev_script" == *"--host"* || "$dev_script" == *"0.0.0.0"* || "$dev_script" == *"-H "* ]]; then
        host_args=""
        bind_note="project config (custom host found)"
    else
        # One glob pass: Vite/Astro/SvelteKit/Nuxt share --host 0.0.0.0,
        # Next.js uses -H, Angular is a plain file check.
        shopt -s nullglob
        local host_flag_cfgs=(
            "$ACTIVE_PROJECT_PATH"/vite.config.*
            "$ACTIVE_PROJECT_PATH"/astro.config.*
            "$ACTIVE_PROJECT_PATH"/svelte.config.*
            "$ACTIVE_PROJECT_PATH"/nuxt.config.*
        )
        local next_cfgs=("$ACTIVE_PROJECT_PATH"/next.config.*)
        shopt -u nullglob

        local target_port="${CLOUDFLARED_APP_PORT:-}"

        if [[ "${#host_flag_cfgs[@]}" -gt 0 ]]; then
            host_args="--host 0.0.0.0${target_port:+ --port $target_port}"
        elif [[ "${#next_cfgs[@]}" -gt 0 ]]; then
            host_args="-H 0.0.0.0${target_port:+ -p $target_port}"
        elif [[ -f "$ACTIVE_PROJECT_PATH/angular.json" ]]; then
            host_args="--host 0.0.0.0${target_port:+ --port $target_port}"
        fi

        [[ -n "$host_args" ]] && bind_note="auto ($host_args)"
    fi

    local command
    case "$manager" in
        npm)  command="npm run dev${host_args:+ -- $host_args}" ;;
        pnpm) command="pnpm dev${host_args:+ $host_args}" ;;
        yarn) command="yarn dev${host_args:+ $host_args}" ;;
        bun)  command="bun run dev${host_args:+ $host_args}" ;;
        *) die "Unsupported package manager: $manager" ;;
    esac

    mkdir -p "$APP_RUNTIME_DIR"
    chmod 775 "$APP_RUNTIME_DIR"
    if [[ "$(stat -c '%u:%g' "$APP_RUNTIME_DIR" 2>/dev/null || true)" != "1001:1001" ]]; then
        sudo chown -R 1001:1001 "$APP_RUNTIME_DIR" 2>/dev/null || true
    fi

    rm -f "$APP_PID_FILE" "$APP_RUNTIME_DIR/pgid" "$APP_BRIDGE_PID_FILE"

    echo "Checking dependencies..."
    ensure_container_package_manager "$manager"

    # Fast path: test if node_modules exists directly on host mount (0ms, avoids docker IPC overhead)
    if [[ ! -d "$ACTIVE_PROJECT_PATH/node_modules" || -z "$(ls -A "$ACTIVE_PROJECT_PATH/node_modules" 2>/dev/null)" ]]; then
        echo "Dependencies missing. Installing from lockfile..."

        local install_cmd
        case "$manager" in
            npm)  install_cmd='npm ci 2>/dev/null || npm install' ;;
            pnpm) install_cmd='pnpm install --frozen-lockfile 2>/dev/null || pnpm install' ;;
            yarn) install_cmd='yarn install --immutable 2>/dev/null || yarn install' ;;
            bun)  install_cmd='bun install --frozen-lockfile 2>/dev/null || bun install' ;;
            *)    die "Unsupported package manager: $manager" ;;
        esac

        docker exec aiws-cli \
            sh -c "export PATH=\"/home/sandbox/.npm-global/bin:\$PATH\"; cd /workspace && ($install_cmd)"

        echo "Dependencies installed."
    else
        echo "Dependencies: ready"
    fi

    echo "Starting $ACTIVE_PROJECT..."
    echo "Package manager: $manager"
    echo "Bind: $bind_note"
    echo "Command: $command"

    local env_allowed_hosts="${ALLOWED_HOSTS:-${CLOUDFLARED_APP_HOSTNAME:-}}"
    local exec_env_flags=()
    if [[ -n "$env_allowed_hosts" ]]; then
        exec_env_flags+=(-e "ALLOWED_HOSTS=$env_allowed_hosts")
    fi
    if [[ -n "${CLOUDFLARED_APP_PORT:-}" ]]; then
        exec_env_flags+=(-e "PORT=${CLOUDFLARED_APP_PORT}")
    fi

    docker exec -d "${exec_env_flags[@]}" aiws-cli \
        /usr/local/bin/app-runner.sh \
        bash -c "$command" >/dev/null

    local ready=0
    local i

    for i in {1..20}; do
        if app_running; then
            ready=1
            break
        fi
        sleep 0.25
    done

    if [[ "$ready" -ne 1 ]]; then
        echo "Project failed to start." >&2
        echo >&2
        echo "Recent logs:" >&2

        docker exec aiws-cli \
            sh -c 'tail -n 80 /run/aiws-cli/app/app.log' >&2 || true

        rm -f "$APP_PID_FILE" "$APP_RUNTIME_DIR/pgid" "$APP_BRIDGE_PID_FILE"
        return 1
    fi

    log_success "Project started."
    echo "PID: $(app_container_pid)"
    echo "Logs: aiws app logs"
}

cmd_app_stop() {
    if ! docker ps --format '{{.Names}}' |
        grep -qx aiws-cli; then
        echo "Workstation is not running."
        return 0
    fi

    local pid
    local pgid

    pid="$(app_container_pid || true)"

    if [[ ! "$pid" =~ ^[0-9]+$ ]]; then
        rm -f "$APP_PID_FILE" "$APP_RUNTIME_DIR/pgid" "$APP_BRIDGE_PID_FILE"
        : > "$APP_RUNTIME_DIR/app.log" 2>/dev/null || true
        echo "Project is not running."
        return 0
    fi

    pgid=""
    if [[ -f "$APP_RUNTIME_DIR/pgid" ]]; then
        pgid="$(<"$APP_RUNTIME_DIR/pgid")"
        pgid="${pgid//[[:space:]]/}"
    fi
    if [[ ! "$pgid" =~ ^[0-9]+$ ]]; then
        pgid="$(docker exec aiws-cli sh -c "ps -o pgid= -p $pid 2>/dev/null | tr -d ' '" 2>/dev/null || true)"
    fi

    local bridge_pid=""
    if [[ -f "$APP_BRIDGE_PID_FILE" ]]; then
        bridge_pid="$(<"$APP_BRIDGE_PID_FILE")"
        bridge_pid="${bridge_pid//[[:space:]]/}"
    fi

    docker exec aiws-cli sh -c "
        if [ -n '$pgid' ] && [ '$pgid' != '1' ]; then
            kill -TERM -- -$pgid 2>/dev/null || true
        fi
        kill -TERM $pid 2>/dev/null || true
        if [ -n '$bridge_pid' ]; then
            kill -TERM $bridge_pid 2>/dev/null || true
        fi
        sleep 0.4
        if [ -n '$pgid' ] && [ '$pgid' != '1' ]; then
            kill -KILL -- -$pgid 2>/dev/null || true
        fi
        kill -KILL $pid 2>/dev/null || true
        if [ -n '$bridge_pid' ]; then
            kill -KILL $bridge_pid 2>/dev/null || true
        fi
    " >/dev/null 2>&1 || true

    rm -f "$APP_PID_FILE" "$APP_RUNTIME_DIR/pgid" "$APP_BRIDGE_PID_FILE"
    : > "$APP_RUNTIME_DIR/app.log" 2>/dev/null || true

    log_success "Project stopped."
}
cmd_app_restart() {
    require_active
    cmd_app_stop
    cmd_run
}

cmd_app_status() {
    load_env

    if [[ "${APP_STATUS_QUIET:-0}" != "1" ]]; then
        echo
        print_header "APPLICATION STATUS"
        echo
    else
        echo -e "\033[1mAPPLICATION\033[0m"
    fi

    echo -e "\033[90mProject  :\033[0m ${ACTIVE_PROJECT:-none}"

    if app_running; then
        echo -e "\033[90mStatus   :\033[0m \033[36mrunning\033[0m"
        local detected_port=""
        if [[ -f "$PORTS_LIB" ]]; then
            detected_port="$(bash "$PORTS_LIB" 2>/dev/null || true)"
        fi
        if [[ -n "$detected_port" ]]; then
            echo -e "\033[90mPort     :\033[0m :${detected_port%% *}"
        elif [[ -n "${CLOUDFLARED_APP_PORT:-}" ]]; then
            echo -e "\033[90mPort     :\033[0m :${CLOUDFLARED_APP_PORT}"
        fi
        echo -e "\033[90mPID      :\033[0m $(app_container_pid)"
    else
        echo -e "\033[90mStatus   :\033[0m stopped"
    fi
}

cmd_app_logs() {
    docker ps --format '{{.Names}}' |
        grep -qx aiws-cli ||
        die "Workstation is not running."

    docker exec aiws-cli \
        sh -c 'tail -n 100 -f /run/aiws-cli/app/app.log'
}

