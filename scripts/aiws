cmd_preview() {
    require_active

    preview_tunnel_section() {
        local current_port="${1:-}"

        [[ -f "${TUNNEL_LIB:-}" && -n "${CLOUDFLARED_TOKEN_SET:-}" && -n "${CLOUDFLARED_APP_HOSTNAME:-}" && -n "${CLOUDFLARED_DSH_HOSTNAME:-}" ]] ||
            return 0

        if [[ -n "$current_port" && "$current_port" != "${CLOUDFLARED_APP_PORT:-}" ]]; then
            echo
            echo "Tunnel port changed (${CLOUDFLARED_APP_PORT:-none} -> $current_port)."

            if bash "$TUNNEL_LIB" sync "$current_port"; then
                load_env
            else
                echo "Tunnel sync failed. Run: aiws tunnel sync $current_port" >&2
            fi
        fi

        echo
        echo "Anywhere URLs:"
        echo "  App : https://${CLOUDFLARED_APP_HOSTNAME}"
        echo "  DSH : https://${CLOUDFLARED_DSH_HOSTNAME}"
        preview_dsh_token_url
    }

    preview_dsh_token_url() {
        # DSH prints a one-time login URL (with token) at startup and
        # rejects bare requests. Reuse its token on the public hostname
        # so the printed URL opens directly with no VPS round-trip.
        local log="$RUNTIME_DIR/harness/harness.log"
        [[ -f "$log" ]] || return 0

        local dsh_origin="http://127.0.0.1:4090"
        local printed
        printed="$(grep -Eom1 "http://127\\.0\\.0\\.1:4090[^[:space:]]*" "$log" 2>/dev/null | tr -d "\"'" || true)"
        [[ -n "$printed" ]] || return 0

        local suffix="${printed#$dsh_origin}"
        [[ -n "$suffix" && "$suffix" != "/" ]] || return 0

        echo "  DSH open: https://${CLOUDFLARED_DSH_HOSTNAME}${suffix}"
    }

    echo; print_header "PREVIEW"
    echo
    echo "Project: $ACTIVE_PROJECT"

    if ! docker ps --format '{{.Names}}' | grep -qx aiws-cli; then
        echo "Workstation: stopped"
        echo "Run: ./scripts/aiws start"
        return 1
    fi

    echo "Workstation: running"

    local container_ip
    container_ip="$(
        docker inspect aiws-cli \
            --format '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' \
            2>/dev/null
    )"

    [[ "$container_ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] ||
        die "Could not determine workstation container IP."

    echo "Container: $container_ip"
    echo

    local app_ports=""
    if app_running; then
        [[ -f "$PORTS_LIB" ]] ||
            die "Port detector not found: $PORTS_LIB"
        app_ports="$(bash "$PORTS_LIB" || true)"
    fi

    if [[ -z "$app_ports" ]]; then
        echo "App: stopped"
        echo
        echo "Run:"
        echo "  ./scripts/aiws run"
        echo
        echo "Then run:"
        echo "  ./scripts/aiws preview"
        echo
        echo "DSH tunnel:"
        echo "  ssh -N -L 4090:${container_ip}:4091 mosabbir-cloud"
        preview_tunnel_section ""
        return 0
    fi

    echo "Detected app port(s): $app_ports"
    echo
    echo "SSH tunnel command:"
    echo

    local port
    printf 'ssh -N \\\n'

    for port in $app_ports; do
        printf '  -L %s:%s:%s \\\n' "$port" "$container_ip" "$port"
    done

    printf '  -L 4090:%s:4091 \\\n' "$container_ip"
    printf '  mosabbir-cloud\n'

    echo
    echo "URLs:"

    local first_port=""
    for port in $app_ports; do
        echo "  App : http://127.0.0.1:$port"
        [[ -z "$first_port" ]] && first_port="$port"
    done

    echo "  DSH : http://127.0.0.1:4090"

    preview_tunnel_section "$first_port"
}

cmd_dsh_update() {
    require_active

    local version="${1:-latest}"

    cmd_harness_stop || true

    if [[ "$version" == "latest" ]]; then
        docker exec -e NARB_DISABLE_NATIVE_CACHE=1 aiws-cli \
            npm install --prefix /home/sandbox/.npm-global \
            @deepseek-ai/dsh@latest
    else
        docker exec -e NARB_DISABLE_NATIVE_CACHE=1 aiws-cli \
            npm install --prefix /home/sandbox/.npm-global \
            "@deepseek-ai/dsh@$version"
    fi

    cmd_harness_start || true

    echo "DSH updated."
}

cmd_dsh_version() {
    docker exec -e NARB_DISABLE_NATIVE_CACHE=1 aiws-cli \
        node /home/sandbox/.npm-global/node_modules/@deepseek-ai/dsh/lib/bin.js \
        --version
}

cmd_cache() {
    echo; print_header "DOCKER"
    docker system df

    echo
    echo; print_header "AI RUNTIME"
    du -sh "$RUNTIME_DIR" 2>/dev/null || true

    echo
    echo; print_header "PROJECT NODE_MODULES"
    find "$PROJECTS_DIR" \
        -type d \
        -name node_modules \
        -prune \
        -exec du -sh {} \; 2>/dev/null || true
}

cmd_cache_clear() {
    local include_deps=0
    local assume_yes=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --deps)
                include_deps=1
                ;;
            --yes|-y)
                assume_yes=1
                ;;
            --help|-h)
                cat <<EOF
Usage:
  aiws cache clear
  aiws cache clear --deps
  aiws cache clear --deps --yes

Safe cleanup:
  - Docker builder cache
  - npm cache

With --deps:
  - project node_modules directories

Never removes:
  - DSH state
  - DSH installation
  - .env
  - Git repositories
  - Docker volumes
  - Docker images
  - Docker containers
EOF
                return 0
                ;;
            *)
                die "Unknown cache option: $1"
                ;;
        esac
        shift
    done

    if [[ "$include_deps" -eq 1 && "$assume_yes" -ne 1 ]]; then
        echo "WARNING: --deps will remove node_modules from all projects."
        echo

        if docker ps --format '{{.Names}}' |
            grep -qx aiws-cli; then
            echo "WARNING: aiws-cli is currently running."
            echo "The active app may stop working until dependencies are reinstalled."
            echo
        fi

        read -r -p "Continue? [y/N] " answer

        case "$answer" in
            y|Y|yes|YES)
                ;;
            *)
                echo "Cancelled. Nothing was removed."
                return 0
                ;;
        esac
    fi

    echo; print_header "CLEANING DOCKER BUILDER CACHE"
    docker builder prune -af

    echo
    echo; print_header "CLEANING NPM CACHE"

    if docker ps --format '{{.Names}}' |
        grep -qx aiws-cli; then
        docker exec aiws-cli npm cache clean --force
    else
        echo "Workstation is not running; npm cache cleanup skipped."
    fi

    if [[ "$include_deps" -eq 1 ]]; then
        echo
        echo; print_header "REMOVING PROJECT DEPENDENCIES"

        local removed=0
        local dir

        while IFS= read -r -d '' dir; do
            echo "Removing: $dir"
            rm -rf -- "$dir"
            removed=1
        done < <(
            find "$PROJECTS_DIR"                 -type d                 -name node_modules                 -prune                 -print0 2>/dev/null
        )

        if [[ "$removed" -eq 0 ]]; then
            echo "No node_modules directories found."
        fi
    fi

    echo
    echo "Cache cleanup complete."
    echo "Run: aiws cache"
}

cmd_update() {
    print_header "UPDATE AIWS"
    echo
    git -C "$ROOT" pull --ff-only
    compose pull
    if is_daemon_running; then
        log_info "Restarting Host Control Daemon..."
        cmd_daemon restart
    fi
}

cmd_upgrade() {
    cmd_update
    compose up -d
    cmd_harness_start
}

cmd_uninstall() {
    print_header "UNINSTALL AIWS"
    echo
    if [[ -f "$ROOT/uninstall.sh" ]]; then
        bash "$ROOT/uninstall.sh" "$@"
    else
        die "uninstall.sh not found."
    fi
}

cmd_doctor() {
    echo; print_header "AIWS DOCTOR"
    echo

    local failures=0
    local container_id=""
    local container_status=""
    local image=""
    local workspace=""
    local dsh_version=""
    local broker_socket=""

    check_ok() {
        echo "✓ $1"
    }

    check_warn() {
        echo "! $1"
    }

    check_fail() {
        echo "✗ $1"
        failures=$((failures + 1))
    }

    # Docker
    if command -v docker >/dev/null 2>&1; then
        check_ok "Docker installed"
    else
        check_fail "Docker not installed"
    fi

    if docker info >/dev/null 2>&1; then
        check_ok "Docker daemon available"
    else
        check_fail "Docker daemon unavailable"
    fi

    # Configuration
    if [[ -f "$ENV_FILE" ]]; then
        check_ok "Configuration file exists"
    else
        check_fail "Configuration file missing: $ENV_FILE"
    fi

    load_env

    if [[ -n "${ACTIVE_PROJECT:-}" ]]; then
        check_ok "Active project configured: ${ACTIVE_PROJECT}"
    else
        check_fail "Active project is not configured"
    fi

    if [[ -n "${ACTIVE_PROJECT_PATH:-}" ]] &&
       [[ -d "${ACTIVE_PROJECT_PATH:-}" ]]; then
        check_ok "Project directory exists: ${ACTIVE_PROJECT_PATH}"
    else
        check_fail "Project directory missing: ${ACTIVE_PROJECT_PATH:-none}"
    fi

    if [[ -n "${ACTIVE_PROJECT_PATH:-}" ]] &&
       [[ -d "${ACTIVE_PROJECT_PATH:-}/.git" ]]; then
        check_ok "Project is a Git repository"
    else
        check_warn "Active project is not detected as a Git repository"
    fi

    echo
    echo; print_header "WORKSTATION"

    if docker ps --format '{{.Names}}' |
       grep -qx aiws-cli; then
        container_id="$(docker ps -q -f name=^aiws-cli$)"
        container_status="$(docker inspect -f '{{.State.Status}}' "$container_id")"
        image="$(docker inspect -f '{{.Config.Image}}' "$container_id")"

        check_ok "Container running"
        check_ok "Container status: $container_status"
        check_ok "Image: $image"
    else
        check_warn "Container is stopped"
    fi

    if [[ -n "$container_id" ]]; then
        local user
        local memory
        local cpus
        local pids
        local privileged
        local security_opt
        local cap_drop

        user="$(docker inspect -f '{{.Config.User}}' "$container_id")"
        memory="$(docker inspect -f '{{.HostConfig.Memory}}' "$container_id")"
        cpus="$(docker inspect -f '{{.HostConfig.NanoCpus}}' "$container_id")"
        pids="$(docker inspect -f '{{.HostConfig.PidsLimit}}' "$container_id")"
        privileged="$(docker inspect -f '{{.HostConfig.Privileged}}' "$container_id")"
        security_opt="$(docker inspect -f '{{join .HostConfig.SecurityOpt ","}}' "$container_id")"
        cap_drop="$(docker inspect -f '{{join .HostConfig.CapDrop ","}}' "$container_id")"

        [[ "$user" == "sandbox" ]] &&
            check_ok "Container user: sandbox" ||
            check_fail "Container user is not sandbox: $user"

        [[ "$memory" == "536870912" ]] &&
            check_ok "Memory limit: 512 MB" ||
            check_warn "Memory limit differs from expected 512 MB: $memory"

        [[ "$cpus" == "1500000000" ]] &&
            check_ok "CPU limit: 1.5" ||
            check_warn "CPU limit differs from expected 1.5: $cpus"

        [[ "$pids" == "256" ]] &&
            check_ok "PID limit: 256" ||
            check_warn "PID limit differs from expected 256: $pids"

        [[ "$privileged" == "false" ]] &&
            check_ok "Privileged: false" ||
            check_fail "Container is privileged"

        [[ "$security_opt" == *"no-new-privileges:true"* ]] &&
            check_ok "No-new-privileges: enabled" ||
            check_fail "No-new-privileges is not enabled"

        [[ "$cap_drop" == *"ALL"* ]] &&
            check_ok "Capabilities: ALL dropped" ||
            check_fail "Capabilities are not fully dropped"

        workspace="$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/workspace"}}{{.Source}}{{end}}{{end}}' "$container_id")"

        if [[ "$workspace" == "${ACTIVE_PROJECT_PATH:-}" ]]; then
            check_ok "Workspace mount matches active project"
        else
            check_fail "Workspace mount mismatch: ${workspace:-none}"
        fi
    fi

    echo
    echo; print_header "DSH / HARNESS"

    if [[ -n "$container_id" ]]; then
        if dsh_version="$(
            docker exec "$container_id" \
                node /home/sandbox/.npm-global/node_modules/@deepseek-ai/dsh/lib/bin.js \
                --version 2>/dev/null
        )"; then
            check_ok "DSH installed: $dsh_version"
        else
            check_fail "DSH is unavailable"
        fi

        if docker exec "$container_id" \
            test -d /home/sandbox/.dsh; then
            check_ok "DSH runtime directory mounted"
        else
            check_fail "DSH runtime directory unavailable"
        fi

        if docker exec "$container_id" \
            /usr/local/bin/harness.sh status >/dev/null 2>&1; then
            check_ok "Harness DSH + bridge running"
        else
            check_warn "Harness is not fully running"
        fi
    else
        check_warn "DSH checks skipped: workstation stopped"
    fi

    echo
    echo; print_header "GITHUB BROKER"

    broker_socket="$RUNTIME_DIR/github-broker/github.sock"

    if [[ -S "$broker_socket" ]]; then
        check_ok "GitHub broker socket exists"
    else
        check_warn "GitHub broker socket unavailable"
    fi

    if [[ -n "$container_id" ]]; then
        if docker exec "$container_id" \
            test -x /usr/local/bin/github-app-credential-helper; then
            check_ok "GitHub credential helper installed"
        else
            check_fail "GitHub credential helper missing"
        fi
    else
        check_warn "GitHub credential helper check skipped: workstation stopped"
    fi

    echo
    echo; print_header "RUNTIME STATE"

    if [[ -d "$RUNTIME_DIR/dsh" ]]; then
        check_ok "DSH persistent state exists"
    else
        check_fail "DSH persistent state missing"
    fi

    if [[ -d "$RUNTIME_DIR/harness" ]]; then
        check_ok "Harness runtime directory exists"
    else
        check_warn "Harness runtime directory missing"
    fi

    if [[ -d "$RUNTIME_DIR/npm-global" ]]; then
        local npm_size
        npm_size="$(du -sh "$RUNTIME_DIR/npm-global" 2>/dev/null | cut -f1)"
        check_ok "Persistent npm runtime exists: $npm_size"
    else
        check_warn "Persistent npm runtime missing"
    fi

    echo
    if [[ "$failures" -eq 0 ]]; then
        echo "Doctor complete: PASS"
        return 0
    fi

    echo "Doctor complete: $failures check(s) failed."
    return 1
}

cmd_state_export() {
    mkdir -p "$HOME/aiws-state-backups"

    local timestamp
    local output
    local staging
    local manifest

    timestamp="$(date +%Y%m%d-%H%M%S)"
    output="$HOME/aiws-state-backups/aiws-state-${timestamp}.tar.gz"
    staging="$(mktemp -d)"
    manifest="$staging/manifest"

    trap 'rm -rf "$staging"' RETURN

    mkdir -p "$staging/dsh"

    [[ -f "$ENV_FILE" ]] ||
        die ".env missing."

    [[ -d "$RUNTIME_DIR/dsh" ]] ||
        die "DSH state directory missing: $RUNTIME_DIR/dsh"

    cp "$ENV_FILE" "$staging/.env"
    cp -a "$RUNTIME_DIR/dsh/." "$staging/dsh/"

    cat > "$manifest" <<EOF
AIWS State Backup
Format: 1
Created: $(date --iso-8601=seconds)
DSH Version: ${DSH_VERSION:-unknown}

Included:
- .env
- runtime/dsh

Excluded:
- runtime/npm-global
- runtime/app
- runtime/harness
- runtime/github-broker
- runtime/github-broker.sock
- GitHub App private key
- project repositories
EOF

    tar -czf "$output" \
        -C "$staging" \
        manifest \
        .env \
        dsh

    chmod 600 "$output"

    echo "State exported:"
    echo "$output"
    echo
    echo "Size: $(du -h "$output" | cut -f1)"
}

cmd_state_import() {
    local archive="${1:-}"
    local staging member safe=1
    local backup_env backup_dsh

    [[ -f "$archive" ]] || die "Usage: aiws state import <archive>"
    command -v tar >/dev/null || die "tar is required."

    staging="$(mktemp -d)"

    cleanup_state_import() {
        rm -rf "$staging"
    }
    trap cleanup_state_import RETURN

    echo "Validating state archive..."

    tar -tzf "$archive" >/dev/null 2>&1 ||
        die "Invalid or corrupted state archive."

    while IFS= read -r member; do
        case "$member" in
            manifest|.env|dsh|dsh/*)
                ;;
            *)
                safe=0
                echo "Unexpected archive entry: $member" >&2
                ;;
        esac

        case "$member" in
            /*|../*|*/../*|*/..|..)
                safe=0
                echo "Unsafe archive path: $member" >&2
                ;;
        esac
    done < <(tar -tzf "$archive")

    [[ "$safe" -eq 1 ]] ||
        die "State archive contains unsafe or unexpected files."

    echo "✓ Archive entries validated"

    echo "Extracting to temporary staging area..."

    tar \
        --no-same-owner \
        --no-same-permissions \
        -xzf "$archive" \
        -C "$staging"

    [[ -f "$staging/manifest" ]] ||
        die "Invalid state archive: manifest missing."

    [[ -f "$staging/.env" ]] ||
        die "Invalid state archive: .env missing."

    [[ -d "$staging/dsh" ]] ||
        die "Invalid state archive: DSH state missing."


    echo "✓ Archive structure validated"

    echo
    echo "Checking staged DSH state..."

    while IFS= read -r link; do
        target="$(readlink "$link")"

        case "$target" in
            /*)
                case "$target" in
                    /home/sandbox/.npm-global/*)
                        ;;
                    *)
                        echo "Unsafe absolute symlink target: $link -> $target" >&2
                        safe=0
                        ;;
                esac
                ;;
            ../*|*/../*|..)
                echo "Unsafe relative symlink target: $link -> $target" >&2
                safe=0
                ;;
        esac
    done < <(find "$staging/dsh" -type l -print)

    [[ "$safe" -eq 1 ]] ||
        die "State archive contains unsafe symlinks."

    if find "$staging/dsh" -type f -links +1 -print -quit 2>/dev/null | grep -q .; then
        die "State archive contains hard-linked files."
    fi

    echo "✓ DSH symlinks validated"

    echo
    echo "Checking current workstation state..."

    backup_env="$(mktemp)"
    backup_dsh="$(mktemp -d)"

    cp "$ENV_FILE" "$backup_env"
    cp -a "$RUNTIME_DIR/dsh/." "$backup_dsh/"

    echo "✓ Current state backed up"

    echo
    log_info "Stopping workstation..."

    compose down >/dev/null 2>&1 || true

    cp "$staging/.env" "$ENV_FILE"
    chmod 600 "$ENV_FILE"

    rm -rf "$RUNTIME_DIR/dsh"
    mkdir -p "$RUNTIME_DIR/dsh"
    cp -a "$staging/dsh/." "$RUNTIME_DIR/dsh/"

    chmod 700 "$RUNTIME_DIR/dsh"
    chmod 600 "$RUNTIME_DIR/dsh/.credentials.yaml" 2>/dev/null || true
    chmod 600 "$RUNTIME_DIR/dsh/settings.yaml" 2>/dev/null || true
    chmod 700 "$RUNTIME_DIR/dsh/storages" 2>/dev/null || true
    chmod 600 "$RUNTIME_DIR/dsh/storages/workspace.json" 2>/dev/null || true

    rm -f "$backup_env"
    rm -rf "$backup_dsh"

    echo
    echo "State imported successfully."
    echo "Run: ./scripts/aiws start"
}

cmd_github() {
    local action="${1:-}"

    [[ -f "$GITHUB_LIB" ]] ||
        die "GitHub module not found: $GITHUB_LIB"

    case "$action" in
        setup|status|test|ensure-service)
            bash "$GITHUB_LIB" "$@"
            ;;
        *)
            die "Usage: aiws github {setup [app_id] [inst_id] [pem]|ensure-service|status|test}"
            ;;
    esac
}

setup_colors() {
    if [[ -t 1 ]]; then
        _C_CYAN=$'\033[38;5;45m'
        _C_GREEN=$'\033[38;5;42m'
        _C_YELLOW=$'\033[38;5;214m'
        _C_BOLD=$'\033[1m'
        _C_DIM=$'\033[2m'
        _C_RESET=$'\033[0m'
    else
        _C_CYAN=""
        _C_GREEN=""
        _C_YELLOW=""
        _C_BOLD=""
        _C_DIM=""
        _C_RESET=""
    fi
}

has_daemon_systemd() {
    command -v systemctl >/dev/null 2>&1 && [[ -f "/etc/systemd/system/aiws-daemon.service" ]]
}

is_daemon_running() {
    if has_daemon_systemd && systemctl is-active --quiet aiws-daemon 2>/dev/null; then
        return 0
    fi
    local pid_file="$RUNTIME_DIR/daemon.pid"
    if [[ -f "$pid_file" ]]; then
        local pid
        pid="$(<"$pid_file")"
        [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null && return 0
    fi
    return 1
}

cmd_daemon() {
    local action="${1:-status}"
    local daemon_script="$ROOT/daemon/server.py"
    local daemon_pid_file="$RUNTIME_DIR/daemon.pid"
    local daemon_log_file="$RUNTIME_DIR/daemon.log"
    local service_name="aiws-daemon"

    case "$action" in
        start)
            if has_daemon_systemd; then
                sudo systemctl start "$service_name"
                if systemctl is-active --quiet "$service_name" 2>/dev/null; then
                    echo "✓ Daemon running via systemd on http://127.0.0.1:8000"
                    return 0
                fi
            fi
            if is_daemon_running; then
                echo "Daemon already running."
                return 0
            fi
            echo "Starting AIWS Host Control Daemon..."
            mkdir -p "$RUNTIME_DIR"
            python3 "$daemon_script" >> "$daemon_log_file" 2>&1 &
            echo $! > "$daemon_pid_file"
            sleep 0.3
            if is_daemon_running; then
                echo "✓ Daemon started (PID: $(<"$daemon_pid_file")) on http://127.0.0.1:8000"
            else
                echo "ERROR: Daemon failed to start. Check $daemon_log_file" >&2
                rm -f "$daemon_pid_file"
                return 1
            fi
            ;;
        stop)
            if has_daemon_systemd; then
                sudo systemctl stop "$service_name"
                echo "✓ Daemon stopped via systemd."
                return 0
            fi
            if [[ -f "$daemon_pid_file" ]]; then
                local pid
                pid="$(<"$daemon_pid_file")"
                if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
                    echo "Stopping Daemon (PID: $pid)..."
                    kill -TERM "$pid" 2>/dev/null || true
                    sleep 0.3
                    kill -9 "$pid" 2>/dev/null || true
                fi
                rm -f "$daemon_pid_file"
                echo "✓ Daemon stopped."
            else
                echo "Daemon is not running."
            fi
            ;;
        restart)
            if has_daemon_systemd; then
                sudo systemctl restart "$service_name"
                echo "✓ Daemon restarted via systemd on http://127.0.0.1:8000"
                return 0
            fi
            cmd_daemon stop
            cmd_daemon start
            ;;
        status)
            if has_daemon_systemd && systemctl is-active --quiet "$service_name" 2>/dev/null; then
                echo "Daemon: running via systemd on http://127.0.0.1:8000"
                return 0
            fi
            if is_daemon_running; then
                echo "Daemon: running (PID: $(<"$daemon_pid_file")) on http://127.0.0.1:8000"
            else
                echo "Daemon: stopped"
            fi
            ;;
        logs)
            if has_daemon_systemd; then
                sudo journalctl -u "$service_name" -n 100 -f
            elif [[ -f "$daemon_log_file" ]]; then
                tail -n 100 -f "$daemon_log_file"
            else
                echo "No daemon log found."
            fi
            ;;
        *)
            die "Usage: aiws daemon {start|stop|restart|status|logs}"
            ;;
    esac
}

print_aiws_banner() {
    setup_colors
    load_env 2>/dev/null || true

    local subtitle="${1:-AIWS CLI · Containerized Dev & Agent Runtime}"
    local proj_badge github_badge tunnel_badge daemon_badge
    if [[ -n "${ACTIVE_PROJECT:-}" ]]; then
        proj_badge="${_C_GREEN}${ACTIVE_PROJECT}${_C_RESET}"
    else
        proj_badge="${_C_YELLOW}none${_C_RESET}"
    fi

    if [[ -n "${GITHUB_APP_ID:-}" && -f "$ROOT/secrets/github-app.pem" ]]; then
        github_badge="${_C_GREEN}ready (#${GITHUB_APP_ID})${_C_RESET}"
    else
        github_badge="${_C_DIM}not set${_C_RESET}"
    fi

    if [[ "${CLOUDFLARED_TOKEN_SET:-}" == "1" ]]; then
        tunnel_badge="${_C_GREEN}${CLOUDFLARED_APP_HOSTNAME:-active}${_C_RESET}"
    else
        tunnel_badge="${_C_DIM}local-only${_C_RESET}"
    fi

    if is_daemon_running; then
        daemon_badge="${_C_GREEN}online (:8000)${_C_RESET}"
    else
        daemon_badge="${_C_YELLOW}stopped${_C_RESET}"
    fi

    local title_len=${#subtitle}
    local pad_len=$((64 - title_len))
    local padding=""
    if [[ $pad_len -gt 0 ]]; then
        padding=$(printf '%*s' "$pad_len" '')
    fi

    cat <<EOF2
${_C_CYAN}╭──────────────────────────────────────────────────────────────────╮
│  ${_C_BOLD} █████╗ ██╗██╗    ██╗███████╗     ██████╗██╗     ██╗${_C_RESET}${_C_CYAN}            │
│  ${_C_BOLD}██╔══██╗██║██║    ██║██╔════╝    ██╔════╝██║     ██║${_C_RESET}${_C_CYAN}            │
│  ${_C_BOLD}███████║██║██║ █╗ ██║███████╗    ██║     ██║     ██║${_C_RESET}${_C_CYAN}            │
│  ${_C_BOLD}██╔══██║██║██║███╗██║╚════██║    ██║     ██║     ██║${_C_RESET}${_C_CYAN}            │
│  ${_C_BOLD}██║  ██║██║╚███╔███╔╝███████║    ╚██████╗███████╗██║${_C_RESET}${_C_CYAN}            │
│  ${_C_BOLD}╚═╝  ╚═╝╚═╝ ╚══╝╚══╝ ╚══════╝     ╚═════╝╚══════╝╚═╝${_C_RESET}${_C_CYAN}            │
│  ${_C_DIM}${subtitle}${_C_RESET}${_C_CYAN}${padding}│
╰──────────────────────────────────────────────────────────────────╯${_C_RESET}
${_C_BOLD}Project:${_C_RESET} $proj_badge
${_C_BOLD}Daemon:${_C_RESET}  $daemon_badge
${_C_BOLD}GitHub:${_C_RESET}  $github_badge
${_C_BOLD}Tunnel:${_C_RESET}  $tunnel_badge
EOF2
}

cmd_setup() {
    local step_results=()

    print_setup_header() {
        clear
        print_header "SETUP & CONFIGURATION"
        echo -e "\033[90mWalk through 5 quick steps to configure your workstation. Every step is optional and can be skipped with [s].\033[0m"
        echo
        for res in "${step_results[@]}"; do
            echo -e "$res"
        done
        [[ ${#step_results[@]} -gt 0 ]] && echo
    }

    print_setup_header

    # ------------------------------------------------------------------
    # STEP 1/5: Host Control Daemon & API Security Key
    # ------------------------------------------------------------------
    local current_key="${WORKSTATION_API_KEY:-}"

    echo -e "\033[1m[Step 1/5] Host Control Daemon & API Key\033[0m"
    echo -e "\033[90mSecures the Host Control Daemon (${_C_BOLD}http://127.0.0.1:8000${_C_RESET}) for your Web Dashboard.\033[0m"
    if [[ -n "$current_key" ]]; then
        echo -e "\033[90mCurrent status: ${_C_GREEN}Configured${_C_RESET} (${current_key:0:6}••••••••)\033[0m"
    else
        echo -e "\033[90mCurrent status: ${_C_YELLOW}No API Key configured (open local access)${_C_RESET}\033[0m"
    fi
    echo -e "\033[90m${_C_BOLD}[1]${_C_RESET} Auto-generate a secure 32-byte API key (Recommended)\033[0m"
    echo -e "\033[90m${_C_BOLD}[2]${_C_RESET} Enter a custom API key\033[0m"
    echo -e "\033[90m${_C_BOLD}[s]${_C_RESET} Skip this step\033[0m"
    echo -e -n "\n\033[90m[\033[36m?\033[90m]\033[0m Select option [1/2/s] (default: s): "; read -r step1_choice || true

    case "${step1_choice:-s}" in
        1)
            local gen_key
            gen_key="$(python3 -c 'import secrets; print("aiws_" + secrets.token_hex(24))' 2>/dev/null || openssl rand -hex 24)"
            set_env_var "WORKSTATION_API_KEY" "$gen_key"
            cmd_daemon restart >/dev/null 2>&1 || cmd_daemon start >/dev/null 2>&1 || true
            step_results+=("\033[90m[\033[32m✓\033[90m]\033[0m \033[32mAPI Key Generated:\033[0m ${gen_key}")
            ;;
        2)
            local custom_key
            echo -e -n "\033[90m[\033[36m?\033[90m]\033[0m Enter custom WORKSTATION_API_KEY: "; read -r custom_key || true
            if [[ -n "$custom_key" ]]; then
                set_env_var "WORKSTATION_API_KEY" "$custom_key"
                cmd_daemon restart >/dev/null 2>&1 || cmd_daemon start >/dev/null 2>&1 || true
                step_results+=("\033[90m[\033[32m✓\033[90m]\033[0m \033[32mCustom API Key Saved\033[0m")
            else
                step_results+=("\033[90m[\033[33m↷\033[90m]\033[0m \033[90mStep 1: Empty input, skipped\033[0m")
            fi
            ;;
        *)
            step_results+=("\033[90m[\033[90m↷\033[90m]\033[0m \033[90mStep 1: Skipped\033[0m")
            ;;
    esac
    echo

    print_setup_header

    # ------------------------------------------------------------------
    # STEP 2/5: GitHub App Credential Broker
    # ------------------------------------------------------------------
    echo -e "\033[1m[Step 2/5] GitHub App Integration (Zero-PAT Broker)\033[0m"
    echo -e "\033[90mEnables private repository cloning, pulling & pushing without storing personal tokens.\033[0m"
    if [[ -n "${GITHUB_APP_ID:-}" && -f "$ROOT/secrets/github-app.pem" ]]; then
        echo -e "\033[90mCurrent status: ${_C_GREEN}Configured (App ID: ${GITHUB_APP_ID}, Installation: ${GITHUB_INSTALLATION_ID:-unset})${_C_RESET}\033[0m"
    else
        echo -e "\033[90mCurrent status: ${_C_YELLOW}Not configured${_C_RESET}\033[0m"
    fi
    echo -e "\033[90m${_C_BOLD}[1]${_C_RESET} Configure GitHub App (App ID, Installation ID, .pem key)\033[0m"
    echo -e "\033[90m${_C_BOLD}[s]${_C_RESET} Skip this step (run 'aiws github setup' anytime later)\033[0m"
    echo -e -n "\n\033[90m[\033[36m?\033[90m]\033[0m Select option [1/s] (default: s): "; read -r step2_choice || true

    case "${step2_choice:-s}" in
        1)
            cmd_github setup && load_env || echo -e "\033[90m[\033[33m!\033[90m]\033[0m \033[33mGitHub setup incomplete — you can retry anytime with: aiws github setup${_C_RESET}"
            ;;
        *)
            step_results+=("\033[90m[\033[90m↷\033[90m]\033[0m \033[90mStep 2: Skipped\033[0m")
            ;;
    esac
    echo

    print_setup_header

    # ------------------------------------------------------------------
    # STEP 3/5: Cloudflare Zero-Trust Tunnel (Anywhere Access)
    # ------------------------------------------------------------------
    echo -e "\033[1m[Step 3/5] Cloudflare Tunnel (Anywhere Access)\033[0m"
    echo -e "\033[90mPublishes your App Preview, DSH Agent Web UI & Host API securely over custom domains.\033[0m"
    if [[ "${CLOUDFLARED_TOKEN_SET:-}" == "1" ]]; then
        echo -e "\033[90mCurrent status: ${_C_GREEN}Configured (App: ${CLOUDFLARED_APP_HOSTNAME:-none}, DSH: ${CLOUDFLARED_DSH_HOSTNAME:-none})${_C_RESET}\033[0m"
    else
        echo -e "\033[90mCurrent status: ${_C_YELLOW}Local-only mode (no tunnel configured)${_C_RESET}\033[0m"
    fi
    echo -e "\033[90m${_C_BOLD}[1]${_C_RESET} Configure Cloudflare Tunnel token & hostnames\033[0m"
    echo -e "\033[90m${_C_BOLD}[s]${_C_RESET} Skip this step (run 'aiws tunnel setup' anytime later)\033[0m"
    echo -e -n "\n\033[90m[\033[36m?\033[90m]\033[0m Select option [1/s] (default: s): "; read -r step3_choice || true

    case "${step3_choice:-s}" in
        1)
            if [[ -f "$TUNNEL_LIB" ]]; then
                bash "$TUNNEL_LIB" setup && load_env || echo -e "\033[90m[\033[33m!\033[90m]\033[0m \033[33mTunnel setup incomplete — retry anytime with: aiws tunnel setup${_C_RESET}"
            fi
            ;;
        *)
            step_results+=("\033[90m[\033[90m↷\033[90m]\033[0m \033[90mStep 3: Skipped\033[0m")
            ;;
    esac
    echo

    print_setup_header

    # ------------------------------------------------------------------
    # STEP 4/5: First Project Workspace (aiws add / aiws use)
    # ------------------------------------------------------------------
    echo -e "\033[1m[Step 4/5] Workspace Project Onboarding\033[0m"
    echo -e "\033[90mClone a GitHub repository into ~/projects and mount it as your active /workspace.\033[0m"
    if [[ -n "${ACTIVE_PROJECT:-}" ]]; then
        echo -e "\033[90mCurrent active project: ${_C_GREEN}${ACTIVE_PROJECT}${_C_RESET} (${ACTIVE_PROJECT_PATH:-})\033[0m"
    else
        echo -e "\033[90mCurrent active project: ${_C_YELLOW}None selected${_C_RESET}\033[0m"
    fi
    echo -e "\033[90m${_C_BOLD}[1]${_C_RESET} Clone a GitHub repository URL and activate it\033[0m"
    echo -e "\033[90m${_C_BOLD}[2]${_C_RESET} Select an existing project from ~/projects\033[0m"
    echo -e "\033[90m${_C_BOLD}[s]${_C_RESET} Skip this step (run 'aiws add <url>' & 'aiws use <name>' later)\033[0m"
    echo -e -n "\n\033[90m[\033[36m?\033[90m]\033[0m Select option [1/2/s] (default: s): "; read -r step4_choice || true

    case "${step4_choice:-s}" in
        1)
            local repo_url repo_name
            echo -e -n "\033[90m[\033[36m?\033[90m]\033[0m GitHub HTTPS URL (e.g. https://github.com/org/repo): " repo_url || true
            if [[ -n "$repo_url" ]]; then
                repo_name="${repo_url%/}"
                repo_name="${repo_name##*/}"
                repo_name="${repo_name%.git}"
                if cmd_add "$repo_url"; then
                    cmd_use "$repo_name" || true
                fi
            else
                echo -e "\033[90m[\033[33m↷\033[90m]\033[0m \033[90mNo URL provided — skipped.${_C_RESET}"
            fi
            ;;
        2)
            echo -e "\033[90mAvailable projects:\033[0m"
            ls -1 "$PROJECTS_DIR" 2>/dev/null | awk \'{print "  " $0}\' || true
            local chosen_proj
            echo -e -n "\033[90m[\033[36m?\033[90m]\033[0m Enter project name to activate: "; read -r chosen_proj || true
            if [[ -n "$chosen_proj" ]]; then
                cmd_use "$chosen_proj" >/dev/null 2>&1 && step_results+=("\033[90m[\033[32m✓\033[90m]\033[0m \033[32mProject Activated:\033[0m $chosen_proj") || step_results+=("\033[90m[\033[33m!\033[90m]\033[0m \033[33mProject Activation Failed\033[0m")
            fi
            ;;
        *)
            step_results+=("\033[90m[\033[90m↷\033[90m]\033[0m \033[90mStep 4: Skipped\033[0m")
            ;;
    esac
    echo

    print_setup_header

    # ------------------------------------------------------------------
    # STEP 5/5: Launch Workstation Runtime & Health Check
    # ------------------------------------------------------------------
    echo -e "\033[1m[Step 5/5] Launch Runtime & System Doctor\033[0m"
    echo -e "\033[90mStart the Docker sandbox container, DSH Agent Harness (:4091), and verify host health.\033[0m"
    echo -e "\033[90m${_C_BOLD}[1]${_C_RESET} Start runtime & run 'aiws doctor' health check now\033[0m"
    echo -e "\033[90m${_C_BOLD}[2]${_C_RESET} Run 'aiws doctor' health check only\033[0m"
    echo -e "\033[90m${_C_BOLD}[s]${_C_RESET} Skip this step\033[0m"
    echo -e -n "\n\033[90m[\033[36m?\033[90m]\033[0m Select option [1/2/s] (default: 1): "; read -r step5_choice || true

    case "${step5_choice:-1}" in
        1)
            cmd_daemon start >/dev/null 2>&1 || true
            if [[ -n "${ACTIVE_PROJECT:-}" ]]; then
                cmd_start || true
            else
                step_results+=("\033[90m[\033[33m!\033[90m]\033[0m \033[33mNo active project, skipped start\033[0m")
                cmd_doctor || true
            fi
            ;;
        2)
            cmd_doctor || true
            ;;
        *)
            step_results+=("\033[90m[\033[90m↷\033[90m]\033[0m \033[90mStep 5: Skipped\033[0m")
            ;;
    esac

    touch "$RUNTIME_DIR/.setup_done"
    print_setup_header
    echo "${_C_CYAN}╭──────────────────────────────────────────────────────────────────╮${_C_RESET}"
    echo "${_C_CYAN}│${_C_RESET}  ${_C_GREEN}${_C_BOLD}✓ AIWS CLI Onboarding Flow Complete!${_C_RESET}                            ${_C_CYAN}│${_C_RESET}"
    echo "${_C_CYAN}├──────────────────────────────────────────────────────────────────┤${_C_RESET}"
    echo "${_C_CYAN}│${_C_RESET}  • Re-run this wizard anytime:   ${_C_BOLD}aiws setup${_C_RESET}                      ${_C_CYAN}│${_C_RESET}"
    echo "${_C_CYAN}│${_C_RESET}  • Check workstation status:     ${_C_BOLD}aiws status${_C_RESET} / ${_C_BOLD}aiws doctor${_C_RESET}       ${_C_CYAN}│${_C_RESET}"
    echo "${_C_CYAN}│${_C_RESET}  • View live preview URLs:       ${_C_BOLD}aiws preview${_C_RESET}                    ${_C_CYAN}│${_C_RESET}"
    echo "${_C_CYAN}│${_C_RESET}  • Enter container shell:        ${_C_BOLD}aiws shell${_C_RESET}                      ${_C_CYAN}│${_C_RESET}"
    echo "${_C_CYAN}╰──────────────────────────────────────────────────────────────────╯${_C_RESET}"
    echo
}

usage() {
    print_aiws_banner
    print_usage_text
}

