#!/usr/bin/env bash
set -euo pipefail

SCRIPT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ROOT="${AI_WORKSTATION_ROOT:-$SCRIPT_ROOT}"
if [[ ! -d "$ROOT" || ! -f "$ROOT/broker/github_broker.py" ]]; then
    ROOT="$SCRIPT_ROOT"
fi
ENV_FILE="$ROOT/.env"
COMPOSE_FILE="$ROOT/docker/compose.yml"
PROJECTS_DIR="$HOME/projects"
RUNTIME_DIR="$ROOT/runtime"
GITHUB_LIB="$ROOT/scripts/lib/github.sh"
TUNNEL_LIB="$ROOT/scripts/lib/tunnel.sh"
PORTS_LIB="$ROOT/scripts/lib/ports.sh"

mkdir -p "$PROJECTS_DIR" "$RUNTIME_DIR"

die() {
    echo "ERROR: $*" >&2
    exit 1
}

load_env() {
    [[ -f "$ENV_FILE" ]] || cp "$ROOT/.env.example" "$ENV_FILE"

    local env_image="${IMAGE:-}"
    local env_dsh_version="${DSH_VERSION:-}"
    local env_root="${AI_WORKSTATION_ROOT:-}"

    set -a
    source "$ENV_FILE"
    set +a

    [[ -n "$env_image" ]] && IMAGE="$env_image"
    [[ -n "$env_dsh_version" ]] && DSH_VERSION="$env_dsh_version"
    [[ -n "$env_root" ]] && AI_WORKSTATION_ROOT="$env_root"
    if [[ ! -d "${AI_WORKSTATION_ROOT:-}" || ! -f "${AI_WORKSTATION_ROOT:-}/broker/github_broker.py" ]]; then
        AI_WORKSTATION_ROOT="$ROOT"
    fi

    # Dev-server hostname allowlist: explicit value wins, otherwise fall
    # back to the tunnel app hostname so `ai tunnel setup` wires it up
    # with no extra step. Empty = local-only.
    ALLOWED_HOSTS="${ALLOWED_HOSTS:-${CLOUDFLARED_APP_HOSTNAME:-}}"

    export IMAGE DSH_VERSION AI_WORKSTATION_ROOT ALLOWED_HOSTS
}

save_env() {
    local image dsh_version workstation_root dsh_trusted_hosts allowed_hosts
    local github_app_id github_installation_id github_broker_gid github_broker_socket
    local tunnel_set tunnel_app_host tunnel_dsh_host tunnel_app_port

    image="$(grep '^IMAGE=' "$ENV_FILE" 2>/dev/null | cut -d= -f2- || true)"
    dsh_version="$(grep '^DSH_VERSION=' "$ENV_FILE" 2>/dev/null | cut -d= -f2- || true)"
    workstation_root="$(grep '^AI_WORKSTATION_ROOT=' "$ENV_FILE" 2>/dev/null | cut -d= -f2- || true)"

    github_app_id="$(grep '^GITHUB_APP_ID=' "$ENV_FILE" 2>/dev/null | cut -d= -f2- || true)"
    github_installation_id="$(grep '^GITHUB_INSTALLATION_ID=' "$ENV_FILE" 2>/dev/null | cut -d= -f2- || true)"
    github_broker_gid="$(grep '^GITHUB_BROKER_GID=' "$ENV_FILE" 2>/dev/null | cut -d= -f2- || true)"
    github_broker_socket="$(grep '^GITHUB_BROKER_SOCKET=' "$ENV_FILE" 2>/dev/null | cut -d= -f2- || true)"

    tunnel_set="$(grep '^CLOUDFLARED_TOKEN_SET=' "$ENV_FILE" 2>/dev/null | cut -d= -f2- || true)"
    tunnel_app_host="$(grep '^CLOUDFLARED_APP_HOSTNAME=' "$ENV_FILE" 2>/dev/null | cut -d= -f2- || true)"
    tunnel_dsh_host="$(grep '^CLOUDFLARED_DSH_HOSTNAME=' "$ENV_FILE" 2>/dev/null | cut -d= -f2- || true)"
    tunnel_app_port="$(grep '^CLOUDFLARED_APP_PORT=' "$ENV_FILE" 2>/dev/null | cut -d= -f2- || true)"

    image="${image:-${IMAGE:-ghcr.io/mosabbir-maruf/ai-workstation-cli:latest}}"
    dsh_version="${dsh_version:-${DSH_VERSION:-0.1.2-rc.1}}"
    workstation_root="${workstation_root:-${AI_WORKSTATION_ROOT:-$ROOT}}"
    dsh_trusted_hosts="$(grep '^DSH_TRUSTED_HOSTS=' "$ENV_FILE" 2>/dev/null | cut -d= -f2- || true)"
    allowed_hosts="$(grep '^ALLOWED_HOSTS=' "$ENV_FILE" 2>/dev/null | cut -d= -f2- || true)"

    cat > "$ENV_FILE" <<EOF2
IMAGE=$image
DSH_VERSION=$dsh_version
DSH_TRUSTED_HOSTS=$dsh_trusted_hosts
ALLOWED_HOSTS=$allowed_hosts
ACTIVE_PROJECT=${ACTIVE_PROJECT:-}
ACTIVE_PROJECT_PATH=${ACTIVE_PROJECT_PATH:-}
AI_WORKSTATION_ROOT=$workstation_root
GITHUB_APP_ID=$github_app_id
GITHUB_INSTALLATION_ID=$github_installation_id
GITHUB_BROKER_SOCKET=$github_broker_socket
GITHUB_BROKER_GID=$github_broker_gid
CLOUDFLARED_TOKEN_SET=$tunnel_set
CLOUDFLARED_APP_HOSTNAME=$tunnel_app_host
CLOUDFLARED_DSH_HOSTNAME=$tunnel_dsh_host
CLOUDFLARED_APP_PORT=$tunnel_app_port
EOF2
}
compose() {
    load_env
    docker compose \
        --project-directory "$ROOT" \
        -f "$COMPOSE_FILE" \
        "$@"
}

require_active() {
    load_env
    [[ -n "${ACTIVE_PROJECT:-}" ]] ||
        die "No active project. Use: ai use <project>"

    [[ -d "${ACTIVE_PROJECT_PATH:-}" ]] ||
        die "Active project path does not exist."
}

cmd_add() {
    local url="${1:-}"
    [[ -n "$url" ]] || die "Usage: ai add <github-url>"

    [[ "$url" =~ ^https://github\.com/[^/]+/[^/]+/?(\.git)?$ ]] ||
        die "Only valid GitHub HTTPS repository URLs are supported."

    local name
    name="$(basename "${url%/}")"
    name="${name%.git}"

    [[ "$name" != "." && "$name" != ".." ]] ||
        die "Invalid repository name."

    [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]] ||
        die "Invalid repository name: $name"

    local destination="$PROJECTS_DIR/$name"

    [[ ! -e "$destination" ]] ||
        die "Project already exists: $name"

    if ! git clone "$url" "$destination"; then
        rm -rf -- "$destination"
        die "Failed to clone repository: $name"
    fi

    echo "Project added: $name"
    echo "Run: ai use $name"
}

cmd_remove() {
    local name="${1:-}"
    [[ -n "$name" ]] || die "Usage: ai remove <project>"

    [[ "$name" != "." && "$name" != ".." ]] ||
        die "Invalid project name."

    [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]] ||
        die "Invalid project name: $name"

    local destination="$PROJECTS_DIR/$name"

    [[ -d "$destination" ]] ||
        die "Project not found: $name"

    [[ -d "$destination/.git" ]] ||
        die "Not a Git project: $name"

    load_env

    if [[ "${ACTIVE_PROJECT:-}" == "$name" ]]; then
        echo "Stopping workstation..."

        compose down >/dev/null 2>&1 || true

        ACTIVE_PROJECT=""
        ACTIVE_PROJECT_PATH=""
        save_env
    fi

    rm -rf -- "$destination"

    echo "Removed: $name"
}

cmd_list() {
    echo "Projects:"
    shopt -s nullglob

    local found=0

    for dir in "$PROJECTS_DIR"/*; do
        if [[ -d "$dir/.git" ]]; then
            found=1

            load_env

            if [[ "${ACTIVE_PROJECT:-}" == "$(basename "$dir")" ]]; then
                echo "  * $(basename "$dir")"
            else
                echo "    $(basename "$dir")"
            fi
        fi
    done

    [[ "$found" -eq 1 ]] || echo "  (none)"
}

cmd_use() {
    local name="${1:-}"
    [[ -n "$name" ]] || die "Usage: ai use <project>"

    local path="$PROJECTS_DIR/$name"

    [[ -d "$path/.git" ]] ||
        die "Git project not found: $name"

    load_env

    if [[ "${ACTIVE_PROJECT:-}" == "$name" ]]; then
        echo "Already active: $name"
        return 0
    fi

    local workstation_running=0

    if docker ps --format '{{.Names}}' |
       grep -qx ai-workstation-cli; then
        workstation_running=1
    fi

    ACTIVE_PROJECT="$name"
    ACTIVE_PROJECT_PATH="$path"

    save_env

    if [[ "$workstation_running" -eq 1 ]]; then
        echo "Switching workstation workspace..."

        compose up -d --force-recreate

        cmd_harness_start
    fi

    echo "Active project: $name"
    echo "Path: $path"
}

cmd_pull() {
    require_active
    cd "$ACTIVE_PROJECT_PATH"
    git pull --ff-only
}

cmd_push() {
    local message="${1:-}"
    [[ -n "$message" ]] || die 'Usage: ai push "commit message"'

    require_active

    cd "$ACTIVE_PROJECT_PATH"

    git add -A

    if git diff --cached --quiet; then
        echo "Nothing to commit."
        return
    fi

    local sensitive_files=""
    sensitive_files="$(
        git diff --cached --name-only --diff-filter=ACM |
        while IFS= read -r file; do
            case "$file" in
                .env|.env.*)
                    [[ "$file" == ".env.example" ]] || echo "$file"
                    ;;
                *.pem|*.key|*.p12|*.pfx)
                    echo "$file"
                    ;;
                credentials.json|service-account*.json)
                    echo "$file"
                    ;;
            esac
        done
    )"

    if [[ -n "$sensitive_files" ]]; then
        git reset >/dev/null

        echo "ERROR: Potentially sensitive files detected:" >&2
        printf '  %s\n' "$sensitive_files" >&2
        echo >&2
        echo "Nothing was committed or pushed." >&2

        return 1
    fi

    git commit -m "$message"
    git push
}

HARNESS_RUNTIME_DIR="$RUNTIME_DIR/harness"

harness_exec() {
    docker exec ai-workstation-cli \
        /usr/local/bin/harness.sh "$@"
}

cmd_harness_start() {
    docker ps --format '{{.Names}}' |
        grep -qx ai-workstation-cli ||
        die "Workstation is not running."

    harness_exec start
}

cmd_harness_stop() {
    docker ps --format '{{.Names}}' |
        grep -qx ai-workstation-cli ||
        return 0

    harness_exec stop
}

cmd_harness_restart() {
    docker ps --format '{{.Names}}' |
        grep -qx ai-workstation-cli ||
        die "Workstation is not running."

    harness_exec restart
}

cmd_harness_status() {
    docker ps --format '{{.Names}}' |
        grep -qx ai-workstation-cli ||
        {
            echo "Harness: stopped (workstation is not running)"
            return 0
        }

    harness_exec status || true
}

cmd_start() {
    require_active

    mkdir -p \
        "$RUNTIME_DIR/dsh" \
        "$RUNTIME_DIR/npm-global" \
        "$HARNESS_RUNTIME_DIR"

    chmod 700 \
        "$RUNTIME_DIR/dsh" \
        "$RUNTIME_DIR/npm-global" \
        "$HARNESS_RUNTIME_DIR"

    if [[ "$(stat -c '%u:%g' "$HARNESS_RUNTIME_DIR" 2>/dev/null || true)" != "1001:1001" ]]; then
        sudo chown -R 1001:1001 "$HARNESS_RUNTIME_DIR"
    fi

    compose up -d

    # Wait up to 30 seconds for the container to become running
    local attempts=0
    while ! docker ps --format '{{.Names}}' | grep -qx ai-workstation-cli; do
        sleep 1
        attempts=$((attempts + 1))
        if [[ "$attempts" -ge 30 ]]; then
            die "Container ai-workstation-cli failed to start within 30 seconds."
        fi
    done

    cmd_harness_start

    echo "Workstation started."
}

cmd_stop() {
    cmd_app_stop || true
    cmd_harness_stop || true
    compose down
    rm -f "$APP_PID_FILE"
    echo "Workstation stopped."
}

cmd_restart() {
    compose restart
    cmd_harness_start
}

APP_RUNTIME_DIR="$RUNTIME_DIR/app"
APP_PID_FILE="$APP_RUNTIME_DIR/pid"

app_container_pid() {
    docker exec ai-workstation-cli sh -lc '
        if [ -f /run/ai-workstation-cli/app/pid ]; then
            cat /run/ai-workstation-cli/app/pid
        fi
    ' 2>/dev/null || true
}

app_running() {
    local pid
    pid="$(app_container_pid)"

    [[ "$pid" =~ ^[0-9]+$ ]] || return 1

    docker exec ai-workstation-cli sh -lc \
        "kill -0 $pid 2>/dev/null"
}

detect_package_manager() {
    require_active

    if [[ -f "$ACTIVE_PROJECT_PATH/package-lock.json" ]]; then
        echo "npm"
    elif [[ -f "$ACTIVE_PROJECT_PATH/pnpm-lock.yaml" ]]; then
        echo "pnpm"
    elif [[ -f "$ACTIVE_PROJECT_PATH/yarn.lock" ]]; then
        echo "yarn"
    elif [[ -f "$ACTIVE_PROJECT_PATH/bun.lockb" || -f "$ACTIVE_PROJECT_PATH/bun.lock" ]]; then
        echo "bun"
    else
        die "Could not detect package manager."
    fi
}

cmd_run() {
    require_active

    docker ps --format '{{.Names}}' |
        grep -qx ai-workstation-cli ||
        die "Workstation is not running. Run: ai start"

    if app_running; then
        echo "Project already running."
        echo "PID: $(app_container_pid)"
        return 0
    fi

    local manager
    manager="$(detect_package_manager)"

    # Central 0.0.0.0 handling: dev servers default to localhost inside the
    # container, which is unreachable from the host/tunnel. Auto-append the
    # framework's host flag unless the project's own dev script already
    # configures a host. Backends (Express/Nest/Fastify/...) typically bind
    # all interfaces by default or respect $HOST, so no flag is needed there.
    local host_args=""
    local bind_note="project config"
    local dev_script=""
    dev_script="$(grep -o '"dev"[[:space:]]*:[[:space:]]*"[^"]*"' "$ACTIVE_PROJECT_PATH/package.json" 2>/dev/null || true)"

    if [[ "$dev_script" == *"--host"* || "$dev_script" == *"0.0.0.0"* || "$dev_script" == *"-H "* ]]; then
        host_args=""
        bind_note="project config (custom host found)"
    else
        # One glob pass: Vite/Astro/SvelteKit/Nuxt share --host 0.0.0.0,
        # Next.js uses -H, Angular is a plain file check.
        shopt -s nullglob
        local host_flag_cfgs=(
            "$ACTIVE_PROJECT_PATH"/vite.config.*
            "$ACTIVE_PROJECT_PATH"/astro.config.*
            "$ACTIVE_PROJECT_PATH"/svelte.config.*
            "$ACTIVE_PROJECT_PATH"/nuxt.config.*
        )
        local next_cfgs=("$ACTIVE_PROJECT_PATH"/next.config.*)
        shopt -u nullglob

        if [[ "${#host_flag_cfgs[@]}" -gt 0 ]]; then
            host_args="--host 0.0.0.0"
        elif [[ "${#next_cfgs[@]}" -gt 0 ]]; then
            host_args="-H 0.0.0.0"
        elif [[ -f "$ACTIVE_PROJECT_PATH/angular.json" ]]; then
            host_args="--host 0.0.0.0"
        fi

        [[ -n "$host_args" ]] && bind_note="auto ($host_args)"
    fi

    local command
    case "$manager" in
        npm)  command='npm run dev' ;;
        pnpm) command='pnpm dev' ;;
        yarn) command='yarn dev' ;;
        bun)  command='bun run dev' ;;
        *) die "Unsupported package manager: $manager" ;;
    esac

    [[ -n "$host_args" ]] && command="$command -- $host_args"

    mkdir -p "$APP_RUNTIME_DIR"
    chmod 700 "$APP_RUNTIME_DIR"

    rm -f "$APP_PID_FILE"

    echo "Checking dependencies..."

    if ! docker exec ai-workstation-cli sh -lc '
        test -d /workspace/node_modules
    '; then
        echo "Dependencies missing. Installing from lockfile..."

        case "$manager" in
            npm)
                docker exec ai-workstation-cli                     sh -lc 'cd /workspace && npm ci'
                ;;
            pnpm)
                docker exec ai-workstation-cli                     sh -lc 'cd /workspace && pnpm install --frozen-lockfile'
                ;;
            yarn)
                docker exec ai-workstation-cli                     sh -lc 'cd /workspace && yarn install --immutable'
                ;;
            bun)
                docker exec ai-workstation-cli                     sh -lc 'cd /workspace && bun install --frozen-lockfile'
                ;;
            *)
                die "Unsupported package manager: $manager"
                ;;
        esac

        echo "Dependencies installed."
    else
        echo "Dependencies: ready"
    fi

    echo "Starting $ACTIVE_PROJECT..."
    echo "Package manager: $manager"
    echo "Bind: $bind_note"
    echo "Command: $command"

    docker exec -d ai-workstation-cli \
        /usr/local/bin/app-runner.sh \
        bash -lc "$command" >/dev/null

    local ready=0
    local i

    for i in {1..20}; do
        if app_running; then
            ready=1
            break
        fi
        sleep 0.25
    done

    if [[ "$ready" -ne 1 ]]; then
        echo "Project failed to start." >&2
        echo >&2
        echo "Recent logs:" >&2

        docker exec ai-workstation-cli \
            sh -lc 'tail -n 80 /run/ai-workstation-cli/app/app.log' >&2 || true

        rm -f "$APP_PID_FILE"
        return 1
    fi

    echo "Project started."
    echo "PID: $(app_container_pid)"
    echo "Logs: ai app logs"
}

cmd_app_stop() {
    if ! docker ps --format '{{.Names}}' |
        grep -qx ai-workstation-cli; then
        echo "Workstation is not running."
        return 0
    fi

    local pid
    local pgid
    local remaining

    pid="$(app_container_pid)"

    if [[ ! "$pid" =~ ^[0-9]+$ ]]; then
        rm -f "$APP_PID_FILE" "$APP_RUNTIME_DIR/pgid"
        echo "Project is not running."
        return 0
    fi

    pgid="$(
        docker exec ai-workstation-cli sh -lc '
            cat /run/ai-workstation-cli/app/pgid 2>/dev/null || true
        ' 2>/dev/null || true
    )"

    if [[ "$pgid" =~ ^[0-9]+$ ]] && [[ "$pgid" != "1" ]]; then
        docker exec ai-workstation-cli sh -lc "
            kill -TERM -- -$pgid 2>/dev/null || true
            sleep 1

            remaining=\$(ps -eo pid=,pgid= | awk -v g='$pgid' '\$2 == g {print \$1}')

            if [ -n \"\$remaining\" ]; then
                kill -KILL \$remaining 2>/dev/null || true
            fi

            kill -TERM $pid 2>/dev/null || true
            sleep 0.25
            kill -KILL $pid 2>/dev/null || true
        " >/dev/null 2>&1 || true
    else
        docker exec ai-workstation-cli sh -lc "
            kill -TERM $pid 2>/dev/null || true
            sleep 1
            kill -KILL $pid 2>/dev/null || true
        " >/dev/null 2>&1 || true
    fi

    rm -f "$APP_PID_FILE" "$APP_RUNTIME_DIR/pgid"

    echo "Project stopped."
}
cmd_app_restart() {
    require_active
    cmd_app_stop
    cmd_run
}

cmd_app_status() {
    load_env

    if [[ "${APP_STATUS_QUIET:-0}" != "1" ]]; then
        echo "=== Project ==="
    fi
    echo "Project: ${ACTIVE_PROJECT:-none}"

    if app_running; then
        echo "Status: running"
        echo "PID: $(app_container_pid)"
    else
        echo "Status: stopped"
    fi
}

cmd_app_logs() {
    docker ps --format '{{.Names}}' |
        grep -qx ai-workstation-cli ||
        die "Workstation is not running."

    docker exec ai-workstation-cli \
        sh -lc 'tail -n 100 -f /run/ai-workstation-cli/app/app.log'
}

cmd_status() {
    load_env

    echo "=== AI Workstation ==="
    echo "Active project: ${ACTIVE_PROJECT:-none}"
    echo "Project path: ${ACTIVE_PROJECT_PATH:-none}"
    echo

    if docker ps --format '{{.Names}}' | grep -qx ai-workstation-cli; then
        echo "Workstation: running"
    else
        echo "Workstation: stopped"
    fi

    echo
    if docker ps --format '{{.Names}}' | grep -qx ai-workstation-cli; then
        harness_exec status || true
    else
        echo "DSH:    stopped"
        echo "Bridge: stopped"
    fi

    echo
    echo "=== App ==="
    APP_STATUS_QUIET=1 cmd_app_status || true
}

cmd_logs() {
    compose logs -f --tail=100
}

cmd_shell() {
    require_active
    docker exec -it ai-workstation-cli bash
}

cmd_preview() {
    require_active

    preview_tunnel_section() {
        local current_port="${1:-}"

        [[ -f "${TUNNEL_LIB:-}" && -n "${CLOUDFLARED_TOKEN_SET:-}" && -n "${CLOUDFLARED_APP_HOSTNAME:-}" && -n "${CLOUDFLARED_DSH_HOSTNAME:-}" ]] ||
            return 0

        if [[ -n "$current_port" && "$current_port" != "${CLOUDFLARED_APP_PORT:-}" ]]; then
            echo
            echo "Tunnel port changed (${CLOUDFLARED_APP_PORT:-none} -> $current_port)."

            if bash "$TUNNEL_LIB" sync "$current_port"; then
                load_env
            else
                echo "Tunnel sync failed. Run: ai tunnel sync $current_port" >&2
            fi
        fi

        echo
        echo "Anywhere URLs:"
        echo "  App : https://${CLOUDFLARED_APP_HOSTNAME}"
        echo "  DSH : https://${CLOUDFLARED_DSH_HOSTNAME}"
        preview_dsh_token_url
    }

    preview_dsh_token_url() {
        # DSH prints a one-time login URL (with token) at startup and
        # rejects bare requests. Reuse its token on the public hostname
        # so the printed URL opens directly with no VPS round-trip.
        local log="$RUNTIME_DIR/harness/harness.log"
        [[ -f "$log" ]] || return 0

        local dsh_origin="http://127.0.0.1:4090"
        local printed
        printed="$(grep -Eom1 "http://127\\.0\\.0\\.1:4090[^[:space:]]*" "$log" 2>/dev/null | tr -d "\"'" || true)"
        [[ -n "$printed" ]] || return 0

        local suffix="${printed#$dsh_origin}"
        [[ -n "$suffix" && "$suffix" != "/" ]] || return 0

        echo "  DSH open: https://${CLOUDFLARED_DSH_HOSTNAME}${suffix}"
    }

    echo "=== Preview ==="
    echo
    echo "Project: $ACTIVE_PROJECT"

    if ! docker ps --format '{{.Names}}' | grep -qx ai-workstation-cli; then
        echo "Workstation: stopped"
        echo "Run: ./scripts/ai start"
        return 1
    fi

    echo "Workstation: running"

    local container_ip
    container_ip="$(
        docker inspect ai-workstation-cli \
            --format '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' \
            2>/dev/null
    )"

    [[ "$container_ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] ||
        die "Could not determine workstation container IP."

    echo "Container: $container_ip"
    echo

    local app_ports=""
    if app_running; then
        [[ -f "$PORTS_LIB" ]] ||
            die "Port detector not found: $PORTS_LIB"
        app_ports="$(bash "$PORTS_LIB" || true)"
    fi

    if [[ -z "$app_ports" ]]; then
        echo "App: stopped"
        echo
        echo "Run:"
        echo "  ./scripts/ai run"
        echo
        echo "Then run:"
        echo "  ./scripts/ai preview"
        echo
        echo "DSH tunnel:"
        echo "  ssh -N -L 4090:${container_ip}:4091 mosabbir-cloud"
        preview_tunnel_section ""
        return 0
    fi

    echo "Detected app port(s): $app_ports"
    echo
    echo "SSH tunnel command:"
    echo

    local port
    printf 'ssh -N \\\n'

    for port in $app_ports; do
        printf '  -L %s:%s:%s \\\n' "$port" "$container_ip" "$port"
    done

    printf '  -L 4090:%s:4091 \\\n' "$container_ip"
    printf '  mosabbir-cloud\n'

    echo
    echo "URLs:"

    local first_port=""
    for port in $app_ports; do
        echo "  App : http://127.0.0.1:$port"
        [[ -z "$first_port" ]] && first_port="$port"
    done

    echo "  DSH : http://127.0.0.1:4090"

    preview_tunnel_section "$first_port"
}

cmd_dsh_update() {
    require_active

    local version="${1:-latest}"

    if [[ "$version" == "latest" ]]; then
        docker exec ai-workstation-cli \
            npm install --prefix /home/sandbox/.npm-global \
            @deepseek-ai/dsh@latest
    else
        docker exec ai-workstation-cli \
            npm install --prefix /home/sandbox/.npm-global \
            "@deepseek-ai/dsh@$version"
    fi

    echo "DSH updated."
}

cmd_dsh_version() {
    docker exec ai-workstation-cli         node /home/sandbox/.npm-global/node_modules/@deepseek-ai/dsh/lib/bin.js         --version
}

cmd_cache() {
    echo "=== Docker ==="
    docker system df

    echo
    echo "=== AI runtime ==="
    du -sh "$RUNTIME_DIR" 2>/dev/null || true

    echo
    echo "=== Project node_modules ==="
    find "$PROJECTS_DIR" \
        -type d \
        -name node_modules \
        -prune \
        -exec du -sh {} \; 2>/dev/null || true
}

cmd_cache_clear() {
    local include_deps=0
    local assume_yes=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --deps)
                include_deps=1
                ;;
            --yes|-y)
                assume_yes=1
                ;;
            --help|-h)
                cat <<EOF
Usage:
  ai cache clear
  ai cache clear --deps
  ai cache clear --deps --yes

Safe cleanup:
  - Docker builder cache
  - npm cache

With --deps:
  - project node_modules directories

Never removes:
  - DSH state
  - DSH installation
  - .env
  - Git repositories
  - Docker volumes
  - Docker images
  - Docker containers
EOF
                return 0
                ;;
            *)
                die "Unknown cache option: $1"
                ;;
        esac
        shift
    done

    if [[ "$include_deps" -eq 1 && "$assume_yes" -ne 1 ]]; then
        echo "WARNING: --deps will remove node_modules from all projects."
        echo

        if docker ps --format '{{.Names}}' |
            grep -qx ai-workstation-cli; then
            echo "WARNING: ai-workstation-cli is currently running."
            echo "The active app may stop working until dependencies are reinstalled."
            echo
        fi

        read -r -p "Continue? [y/N] " answer

        case "$answer" in
            y|Y|yes|YES)
                ;;
            *)
                echo "Cancelled. Nothing was removed."
                return 0
                ;;
        esac
    fi

    echo "=== Cleaning Docker builder cache ==="
    docker builder prune -af

    echo
    echo "=== Cleaning npm cache ==="

    if docker ps --format '{{.Names}}' |
        grep -qx ai-workstation-cli; then
        docker exec ai-workstation-cli npm cache clean --force
    else
        echo "Workstation is not running; npm cache cleanup skipped."
    fi

    if [[ "$include_deps" -eq 1 ]]; then
        echo
        echo "=== Removing project dependencies ==="

        local removed=0
        local dir

        while IFS= read -r -d '' dir; do
            echo "Removing: $dir"
            rm -rf -- "$dir"
            removed=1
        done < <(
            find "$PROJECTS_DIR"                 -type d                 -name node_modules                 -prune                 -print0 2>/dev/null
        )

        if [[ "$removed" -eq 0 ]]; then
            echo "No node_modules directories found."
        fi
    fi

    echo
    echo "Cache cleanup complete."
    echo "Run: ai cache"
}

cmd_update() {
    git -C "$ROOT" pull --ff-only
    compose pull
}

cmd_upgrade() {
    cmd_update
    compose up -d
    cmd_harness_start
}

cmd_doctor() {
    echo "=== AI Workstation Doctor ==="
    echo

    local failures=0
    local container_id=""
    local container_status=""
    local image=""
    local workspace=""
    local dsh_version=""
    local broker_socket=""

    check_ok() {
        echo "✓ $1"
    }

    check_warn() {
        echo "! $1"
    }

    check_fail() {
        echo "✗ $1"
        failures=$((failures + 1))
    }

    # Docker
    if command -v docker >/dev/null 2>&1; then
        check_ok "Docker installed"
    else
        check_fail "Docker not installed"
    fi

    if docker info >/dev/null 2>&1; then
        check_ok "Docker daemon available"
    else
        check_fail "Docker daemon unavailable"
    fi

    # Configuration
    if [[ -f "$ENV_FILE" ]]; then
        check_ok "Configuration file exists"
    else
        check_fail "Configuration file missing: $ENV_FILE"
    fi

    load_env

    if [[ -n "${ACTIVE_PROJECT:-}" ]]; then
        check_ok "Active project configured: ${ACTIVE_PROJECT}"
    else
        check_fail "Active project is not configured"
    fi

    if [[ -n "${ACTIVE_PROJECT_PATH:-}" ]] &&
       [[ -d "${ACTIVE_PROJECT_PATH:-}" ]]; then
        check_ok "Project directory exists: ${ACTIVE_PROJECT_PATH}"
    else
        check_fail "Project directory missing: ${ACTIVE_PROJECT_PATH:-none}"
    fi

    if [[ -n "${ACTIVE_PROJECT_PATH:-}" ]] &&
       [[ -d "${ACTIVE_PROJECT_PATH:-}/.git" ]]; then
        check_ok "Project is a Git repository"
    else
        check_warn "Active project is not detected as a Git repository"
    fi

    echo
    echo "=== Workstation ==="

    if docker ps --format '{{.Names}}' |
       grep -qx ai-workstation-cli; then
        container_id="$(docker ps -q -f name=^ai-workstation-cli$)"
        container_status="$(docker inspect -f '{{.State.Status}}' "$container_id")"
        image="$(docker inspect -f '{{.Config.Image}}' "$container_id")"

        check_ok "Container running"
        check_ok "Container status: $container_status"
        check_ok "Image: $image"
    else
        check_warn "Container is stopped"
    fi

    if [[ -n "$container_id" ]]; then
        local user
        local memory
        local cpus
        local pids
        local privileged
        local security_opt
        local cap_drop

        user="$(docker inspect -f '{{.Config.User}}' "$container_id")"
        memory="$(docker inspect -f '{{.HostConfig.Memory}}' "$container_id")"
        cpus="$(docker inspect -f '{{.HostConfig.NanoCpus}}' "$container_id")"
        pids="$(docker inspect -f '{{.HostConfig.PidsLimit}}' "$container_id")"
        privileged="$(docker inspect -f '{{.HostConfig.Privileged}}' "$container_id")"
        security_opt="$(docker inspect -f '{{join .HostConfig.SecurityOpt ","}}' "$container_id")"
        cap_drop="$(docker inspect -f '{{join .HostConfig.CapDrop ","}}' "$container_id")"

        [[ "$user" == "sandbox" ]] &&
            check_ok "Container user: sandbox" ||
            check_fail "Container user is not sandbox: $user"

        [[ "$memory" == "536870912" ]] &&
            check_ok "Memory limit: 512 MB" ||
            check_warn "Memory limit differs from expected 512 MB: $memory"

        [[ "$cpus" == "1500000000" ]] &&
            check_ok "CPU limit: 1.5" ||
            check_warn "CPU limit differs from expected 1.5: $cpus"

        [[ "$pids" == "256" ]] &&
            check_ok "PID limit: 256" ||
            check_warn "PID limit differs from expected 256: $pids"

        [[ "$privileged" == "false" ]] &&
            check_ok "Privileged: false" ||
            check_fail "Container is privileged"

        [[ "$security_opt" == *"no-new-privileges:true"* ]] &&
            check_ok "No-new-privileges: enabled" ||
            check_fail "No-new-privileges is not enabled"

        [[ "$cap_drop" == *"ALL"* ]] &&
            check_ok "Capabilities: ALL dropped" ||
            check_fail "Capabilities are not fully dropped"

        workspace="$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/workspace"}}{{.Source}}{{end}}{{end}}' "$container_id")"

        if [[ "$workspace" == "${ACTIVE_PROJECT_PATH:-}" ]]; then
            check_ok "Workspace mount matches active project"
        else
            check_fail "Workspace mount mismatch: ${workspace:-none}"
        fi
    fi

    echo
    echo "=== DSH / Harness ==="

    if [[ -n "$container_id" ]]; then
        if dsh_version="$(
            docker exec "$container_id" \
                node /home/sandbox/.npm-global/node_modules/@deepseek-ai/dsh/lib/bin.js \
                --version 2>/dev/null
        )"; then
            check_ok "DSH installed: $dsh_version"
        else
            check_fail "DSH is unavailable"
        fi

        if docker exec "$container_id" \
            test -d /home/sandbox/.dsh; then
            check_ok "DSH runtime directory mounted"
        else
            check_fail "DSH runtime directory unavailable"
        fi

        if docker exec "$container_id" \
            /usr/local/bin/harness.sh status >/dev/null 2>&1; then
            check_ok "Harness DSH + bridge running"
        else
            check_warn "Harness is not fully running"
        fi
    else
        check_warn "DSH checks skipped: workstation stopped"
    fi

    echo
    echo "=== GitHub Broker ==="

    broker_socket="$RUNTIME_DIR/github-broker/github.sock"

    if [[ -S "$broker_socket" ]]; then
        check_ok "GitHub broker socket exists"
    else
        check_warn "GitHub broker socket unavailable"
    fi

    if [[ -n "$container_id" ]]; then
        if docker exec "$container_id" \
            test -x /usr/local/bin/github-app-credential-helper; then
            check_ok "GitHub credential helper installed"
        else
            check_fail "GitHub credential helper missing"
        fi
    else
        check_warn "GitHub credential helper check skipped: workstation stopped"
    fi

    echo
    echo "=== Runtime State ==="

    if [[ -d "$RUNTIME_DIR/dsh" ]]; then
        check_ok "DSH persistent state exists"
    else
        check_fail "DSH persistent state missing"
    fi

    if [[ -d "$RUNTIME_DIR/harness" ]]; then
        check_ok "Harness runtime directory exists"
    else
        check_warn "Harness runtime directory missing"
    fi

    if [[ -d "$RUNTIME_DIR/npm-global" ]]; then
        local npm_size
        npm_size="$(du -sh "$RUNTIME_DIR/npm-global" 2>/dev/null | cut -f1)"
        check_ok "Persistent npm runtime exists: $npm_size"
    else
        check_warn "Persistent npm runtime missing"
    fi

    echo
    if [[ "$failures" -eq 0 ]]; then
        echo "Doctor complete: PASS"
        return 0
    fi

    echo "Doctor complete: $failures check(s) failed."
    return 1
}

cmd_state_export() {
    mkdir -p "$HOME/ai-state-backups"

    local timestamp
    local output
    local staging
    local manifest

    timestamp="$(date +%Y%m%d-%H%M%S)"
    output="$HOME/ai-state-backups/ai-state-${timestamp}.tar.gz"
    staging="$(mktemp -d)"
    manifest="$staging/manifest"

    trap 'rm -rf "$staging"' RETURN

    mkdir -p "$staging/dsh"

    [[ -f "$ENV_FILE" ]] ||
        die ".env missing."

    [[ -d "$RUNTIME_DIR/dsh" ]] ||
        die "DSH state directory missing: $RUNTIME_DIR/dsh"

    cp "$ENV_FILE" "$staging/.env"
    cp -a "$RUNTIME_DIR/dsh/." "$staging/dsh/"

    cat > "$manifest" <<EOF
AI Workstation State Backup
Format: 1
Created: $(date --iso-8601=seconds)
DSH Version: ${DSH_VERSION:-unknown}

Included:
- .env
- runtime/dsh

Excluded:
- runtime/npm-global
- runtime/app
- runtime/harness
- runtime/github-broker
- runtime/github-broker.sock
- GitHub App private key
- project repositories
EOF

    tar -czf "$output" \
        -C "$staging" \
        manifest \
        .env \
        dsh

    chmod 600 "$output"

    echo "State exported:"
    echo "$output"
    echo
    echo "Size: $(du -h "$output" | cut -f1)"
}

cmd_state_import() {
    local archive="${1:-}"
    local staging member safe=1
    local backup_env backup_dsh

    [[ -f "$archive" ]] || die "Usage: ai state import <archive>"
    command -v tar >/dev/null || die "tar is required."

    staging="$(mktemp -d)"

    cleanup_state_import() {
        rm -rf "$staging"
    }
    trap cleanup_state_import RETURN

    echo "Validating state archive..."

    tar -tzf "$archive" >/dev/null 2>&1 ||
        die "Invalid or corrupted state archive."

    while IFS= read -r member; do
        case "$member" in
            manifest|.env|dsh|dsh/*)
                ;;
            *)
                safe=0
                echo "Unexpected archive entry: $member" >&2
                ;;
        esac

        case "$member" in
            /*|../*|*/../*|*/..|..)
                safe=0
                echo "Unsafe archive path: $member" >&2
                ;;
        esac
    done < <(tar -tzf "$archive")

    [[ "$safe" -eq 1 ]] ||
        die "State archive contains unsafe or unexpected files."

    echo "✓ Archive entries validated"

    echo "Extracting to temporary staging area..."

    tar \
        --no-same-owner \
        --no-same-permissions \
        -xzf "$archive" \
        -C "$staging"

    [[ -f "$staging/manifest" ]] ||
        die "Invalid state archive: manifest missing."

    [[ -f "$staging/.env" ]] ||
        die "Invalid state archive: .env missing."

    [[ -d "$staging/dsh" ]] ||
        die "Invalid state archive: DSH state missing."


    echo "✓ Archive structure validated"

    echo
    echo "Checking staged DSH state..."

    while IFS= read -r link; do
        target="$(readlink "$link")"

        case "$target" in
            /*)
                case "$target" in
                    /home/sandbox/.npm-global/*)
                        ;;
                    *)
                        echo "Unsafe absolute symlink target: $link -> $target" >&2
                        safe=0
                        ;;
                esac
                ;;
            ../*|*/../*|..)
                echo "Unsafe relative symlink target: $link -> $target" >&2
                safe=0
                ;;
        esac
    done < <(find "$staging/dsh" -type l -print)

    [[ "$safe" -eq 1 ]] ||
        die "State archive contains unsafe symlinks."

    if find "$staging/dsh" -type f -links +1 -print -quit 2>/dev/null | grep -q .; then
        die "State archive contains hard-linked files."
    fi

    echo "✓ DSH symlinks validated"

    echo
    echo "Checking current workstation state..."

    backup_env="$(mktemp)"
    backup_dsh="$(mktemp -d)"

    cp "$ENV_FILE" "$backup_env"
    cp -a "$RUNTIME_DIR/dsh/." "$backup_dsh/"

    echo "✓ Current state backed up"

    echo
    echo "Stopping workstation..."

    compose down >/dev/null 2>&1 || true

    cp "$staging/.env" "$ENV_FILE"
    chmod 600 "$ENV_FILE"

    rm -rf "$RUNTIME_DIR/dsh"
    mkdir -p "$RUNTIME_DIR/dsh"
    cp -a "$staging/dsh/." "$RUNTIME_DIR/dsh/"

    chmod 700 "$RUNTIME_DIR/dsh"
    chmod 600 "$RUNTIME_DIR/dsh/.credentials.yaml" 2>/dev/null || true
    chmod 600 "$RUNTIME_DIR/dsh/settings.yaml" 2>/dev/null || true
    chmod 700 "$RUNTIME_DIR/dsh/storages" 2>/dev/null || true
    chmod 600 "$RUNTIME_DIR/dsh/storages/workspace.json" 2>/dev/null || true

    rm -f "$backup_env"
    rm -rf "$backup_dsh"

    echo
    echo "State imported successfully."
    echo "Run: ./scripts/ai start"
}

cmd_github() {
    local action="${1:-}"

    [[ -f "$GITHUB_LIB" ]] ||
        die "GitHub module not found: $GITHUB_LIB"

    case "$action" in
        setup|status|test|ensure-service)
            bash "$GITHUB_LIB" "$@"
            ;;
        *)
            die "Usage: ai github {setup [app_id] [inst_id] [pem]|ensure-service|status|test}"
            ;;
    esac
}

usage() {
    cat <<EOF2
AI Workstation

Projects:
  ai add <github-url>
  ai remove <project>
  ai list
  ai use <project>

Git:
  ai pull
  ai push "commit message"

Runtime:
  ai start
  ai stop
  ai restart
  ai status
  ai logs
  ai shell
  ai run
  ai app stop
  ai app restart
  ai app status
  ai app logs
  ai preview

DSH:
  ai dsh update [version]
  ai dsh version

Maintenance:
  ai cache
  ai cache clear
  ai update
  ai upgrade
  ai doctor

GitHub:
  ai github setup
  ai github status
  ai github test

Tunnel (anywhere access):
  ai tunnel setup
  ai tunnel sync [port]
  ai tunnel status
  ai tunnel start
  ai tunnel stop
  ai tunnel logs

State:
  ai state export
  ai state import <archive>

Daemon (Web Dashboard HTTP API):
  ai daemon start
  ai daemon stop
  ai daemon restart
  ai daemon status
EOF2
}

case "${1:-}" in
    add) shift; cmd_add "$@" ;;
    remove) shift; cmd_remove "$@" ;;
    list) cmd_list ;;
    use) shift; cmd_use "$@" ;;
    pull) cmd_pull ;;
    push) shift; cmd_push "$@" ;;
    start) cmd_start ;;
    stop) cmd_stop ;;
    restart) cmd_restart ;;
    harness)
        shift
        case "${1:-}" in
            start)
                cmd_harness_start
                ;;
            stop)
                cmd_harness_stop
                ;;
            restart)
                cmd_harness_restart
                ;;
            status)
                cmd_harness_status
                ;;
            *)
                die "Usage: ai harness {start|stop|restart|status}"
                ;;
        esac
        ;;
    status) cmd_status ;;
    logs) cmd_logs ;;
    shell) cmd_shell ;;
    run) cmd_run ;;
    app)
        shift
        case "${1:-}" in
            stop)
                cmd_app_stop
                ;;
            restart)
                cmd_app_restart
                ;;
            status)
                cmd_app_status
                ;;
            logs)
                cmd_app_logs
                ;;
            *)
                die "Usage: ai app {stop|restart|status|logs}"
                ;;
        esac
        ;;
    preview) cmd_preview ;;
    dsh)
        shift
        case "${1:-}" in
            update)
                shift
                cmd_dsh_update "$@"
                ;;
            version)
                cmd_dsh_version
                ;;
            *)
                die "Usage: ai dsh {update|version}"
                ;;
        esac
        ;;
    cache)
        shift

        case "${1:-}" in
            clear)
                shift
                cmd_cache_clear "$@"
                ;;
            --help|-h|"")
                cmd_cache
                ;;
            *)
                die "Usage: ai cache [clear [--deps] [--yes]]"
                ;;
        esac
        ;;
    update) cmd_update ;;
    upgrade) cmd_upgrade ;;
    doctor) cmd_doctor ;;
    github)
        shift
        cmd_github "$@"
        ;;
    tunnel)
        shift
        [[ -f "$TUNNEL_LIB" ]] ||
            die "Tunnel module not found: $TUNNEL_LIB"
        case "${1:-}" in
            setup|sync|status|start|stop|logs)
                bash "$TUNNEL_LIB" "$@"
                ;;
            *)
                die "Usage: ai tunnel {setup|sync [port]|status|start|stop|logs}"
                ;;
        esac
        ;;
    state)
        shift
        case "${1:-}" in
            export) cmd_state_export ;;
            import)
                shift
                cmd_state_import "$@"
                ;;
            *)
                die "Usage: ai state {export|import}"
                ;;
        esac
        ;;
    daemon)
        shift
        DAEMON_SCRIPT="$ROOT/daemon/server.py"
        DAEMON_PID_FILE="$RUNTIME_DIR/daemon.pid"
        DAEMON_LOG_FILE="$RUNTIME_DIR/daemon.log"
        SERVICE_NAME="ai-workstation-daemon"

        has_systemd_service() {
            command -v systemctl >/dev/null 2>&1 && [[ -f "/etc/systemd/system/${SERVICE_NAME}.service" ]]
        }

        case "${1:-status}" in
            start)
                if has_systemd_service; then
                    sudo systemctl start "$SERVICE_NAME"
                    if sudo systemctl is-active --quiet "$SERVICE_NAME"; then
                        echo "✓ Daemon running via systemd on http://127.0.0.1:8000"
                        exit 0
                    fi
                fi
                if [[ -f "$DAEMON_PID_FILE" ]] && kill -0 "$(cat "$DAEMON_PID_FILE" 2>/dev/null)" 2>/dev/null; then
                    echo "Daemon already running (PID: $(cat "$DAEMON_PID_FILE"))."
                    exit 0
                fi
                echo "Starting AI Workstation Host Control Daemon..."
                mkdir -p "$RUNTIME_DIR"
                python3 "$DAEMON_SCRIPT" >> "$DAEMON_LOG_FILE" 2>&1 &
                echo $! > "$DAEMON_PID_FILE"
                sleep 0.5
                if kill -0 "$(cat "$DAEMON_PID_FILE" 2>/dev/null)" 2>/dev/null; then
                    echo "✓ Daemon started (PID: $(cat "$DAEMON_PID_FILE")) on http://127.0.0.1:8000"
                else
                    echo "ERROR: Daemon failed to start. Check $DAEMON_LOG_FILE" >&2
                    rm -f "$DAEMON_PID_FILE"
                    exit 1
                fi
                ;;
            stop)
                if has_systemd_service; then
                    sudo systemctl stop "$SERVICE_NAME"
                    echo "✓ Daemon stopped via systemd."
                    exit 0
                fi
                if [[ -f "$DAEMON_PID_FILE" ]]; then
                    pid="$(cat "$DAEMON_PID_FILE" 2>/dev/null || true)"
                    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
                        echo "Stopping Daemon (PID: $pid)..."
                        kill -TERM "$pid" 2>/dev/null || true
                        sleep 0.5
                        kill -9 "$pid" 2>/dev/null || true
                    fi
                    rm -f "$DAEMON_PID_FILE"
                    echo "✓ Daemon stopped."
                else
                    echo "Daemon is not running."
                fi
                ;;
            restart)
                if has_systemd_service; then
                    sudo systemctl restart "$SERVICE_NAME"
                    echo "✓ Daemon restarted via systemd on http://127.0.0.1:8000"
                    exit 0
                fi
                "$0" daemon stop
                "$0" daemon start
                ;;
            status)
                if has_systemd_service && sudo systemctl is-active --quiet "$SERVICE_NAME"; then
                    echo "Daemon: running via systemd on http://127.0.0.1:8000"
                    exit 0
                fi
                if [[ -f "$DAEMON_PID_FILE" ]] && kill -0 "$(cat "$DAEMON_PID_FILE" 2>/dev/null)" 2>/dev/null; then
                    echo "Daemon: running (PID: $(cat "$DAEMON_PID_FILE")) on http://127.0.0.1:8000"
                else
                    echo "Daemon: stopped"
                fi
                ;;
            logs)
                if has_systemd_service; then
                    sudo journalctl -u "$SERVICE_NAME" -n 100 -f
                elif [[ -f "$DAEMON_LOG_FILE" ]]; then
                    tail -n 100 -f "$DAEMON_LOG_FILE"
                else
                    echo "No daemon log found."
                fi
                ;;
            *)
                die "Usage: ai daemon {start|stop|restart|status|logs}"
                ;;
        esac
        ;;
    help|--help|-h|"") usage ;;
    *) die "Unknown command: $1" ;;
esac
