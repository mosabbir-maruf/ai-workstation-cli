# AI Workstation Environment Configuration
# Copy this file to .env and configure as needed.
# Permissions should be set to 600 (chmod 600 .env).

# Workstation container image (multi-arch: amd64/arm64)
IMAGE=ghcr.io/mosabbir-maruf/ai-workstation-cli:latest

# DeepSeek Harness (DSH) version
DSH_VERSION=0.1.2-rc.1

# Extra authorities the DSH /api browser-trust fence accepts
# (e.g. the public Cloudflare DSH hostname; space/comma-separated)
DSH_TRUSTED_HOSTS=

# Active project configuration (managed automatically by `ai use <project>`)
ACTIVE_PROJECT=
ACTIVE_PROJECT_PATH=

# Workstation root path on host (defaults to repository root)
AI_WORKSTATION_ROOT=

# GitHub App Authentication (configured via `ai github setup`)
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_BROKER_SOCKET=
GITHUB_BROKER_GID=

# App hostname allowlist for dev servers (comma-separated).
# Empty = local-only. Set to the public hostname(s), e.g. via `ai tunnel setup`.
ALLOWED_HOSTS=

# Anywhere access via Cloudflare Tunnel (configured via `ai tunnel setup`)
CLOUDFLARED_TOKEN_SET=
CLOUDFLARED_APP_HOSTNAME=
CLOUDFLARED_DSH_HOSTNAME=
CLOUDFLARED_APP_PORT=